// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// บทบาทผู้ใช้ (ผู้ใช้กำหนด 2026-09-22) - คนเดียวถือได้หลายบทบาท (User.roles)
// ADMIN = เจ้าของ/ผู้ดูแลระบบ ทำได้ทุกอย่าง + อนุมัติผู้ใช้
// STAFF_ENTRY = พนักงานรับข้อมูลรถ: ขั้น 1-3 (เพิ่มข้อมูลรถ, แจ้งย้าย/ตัดบัญชี, ตรวจรถ) ทุกประเภทรถ
// STAFF_CAR / STAFF_MOTO = พนักงานยื่นรถยนต์ / จักรยานยนต์: ขั้น 4-8 (ยื่นเอกสาร -> Delivery) เฉพาะประเภทรถของตัวเอง
//   (แยกจาก Vehicle.body ขึ้นต้น "รย.12-" = จักรยานยนต์ - ดู backend/src/auth/vehicle-scope.ts) ถือทั้งคู่ = เห็นทุกคัน
// ACCOUNTANT = บัญชี/วางบิล + อ่านข้อมูลงานได้ | DELIVERY = ส่งของ (เห็นเฉพาะหน้า Delivery ไม่เห็นราคา)
// CUSTOMER = ลูกค้า (portal) เห็นเฉพาะรถของบริษัทที่ผูกไว้ (User.customerId)
enum UserRole {
  ADMIN
  STAFF_ENTRY
  STAFF_CAR
  STAFF_MOTO
  ACCOUNTANT
  DELIVERY
  CUSTOMER
}

// สมัครแล้วเป็น PENDING จนกว่า Admin จะอนุมัติ - ล็อกอินได้เฉพาะ APPROVED
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum DocumentType {
  NEW_REGISTRATION // จดทะเบียนรถใหม่
  PLATE_SWAP // สลับเลขทะเบียน
  TRANSFER // โอนรถ
  ADDRESS_CHANGE // แจ้งย้าย
  OTHER // งานทะเบียนอื่นๆ
}

enum CaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique // ใช้เป็น username ตอนล็อกอิน (เก็บเป็นตัวพิมพ์เล็ก)
  passwordHash     String // scrypt (ดู backend/src/auth/password.ts)
  name             String // ชื่อ-นามสกุล
  displayName      String? // ชื่อเล่น - ใช้แสดงในหัวใบส่งงาน/ประวัติแก้ไข
  phone            String?
  roles            UserRole[] @default([]) // ว่างจนกว่า Admin อนุมัติ (Admin กำหนดตอนอนุมัติ)
  status           UserStatus @default(PENDING)
  // ตอนสมัคร: พนักงานเลือกตำแหน่งที่ขอ / ลูกค้ากรอกชื่อบริษัท - Admin ดูประกอบตอนอนุมัติ
  requestedRole    UserRole? // STAFF_ENTRY | STAFF_CAR | STAFF_MOTO | ACCOUNTANT | DELIVERY | CUSTOMER
  requestedCompany String? // ลูกค้าพิมพ์ชื่อบริษัท/ร้านตอนสมัคร Admin เลือกผูก customerId ให้ตอนอนุมัติ
  customerId       String? // ผูกบัญชีลูกค้ากับรายชื่อในฐานข้อมูลลูกค้า (เฉพาะ role CUSTOMER)
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer           Customer?               @relation(fields: [customerId], references: [id])
  approvedBy         User?                   @relation("ApprovedUsers", fields: [approvedById], references: [id])
  approvedUsers      User[]                  @relation("ApprovedUsers")
  assignedCases      Case[]                  @relation("AssignedStaff")
  deletedVehicles    Vehicle[]               @relation("DeletedVehicles")
  vehicleEdits       VehicleEditLog[]        @relation("VehicleEdits")
  deliverySlips      DeliverySlip[]          @relation("DeliverySlips")
  cancelledSlips     DeliverySlip[]          @relation("DeliverySlipCancels")
  cancelledSlipItems DeliverySlipItem[]      @relation("DeliverySlipItemCancels")
  auditLogs          AuditLog[]              @relation("AuditLogs")
  cancelledTaxRenews TaxRenewal[]            @relation("TaxRenewalCancels")
  cancelledYamaha    YamahaRelocationEntry[] @relation("YamahaRelocationCancels")
  cancelledSwaps     PlateSwap[]             @relation("PlateSwapCancels")
  cancelledUseCancellations VehicleUseCancellation[] @relation("VehicleUseCancellationCancels")
  cancelledPlateCopies PlateCopy[] @relation("PlateCopyCancels")
  billingClosures    Vehicle[]               @relation("VehicleBillingClosures")
  accountPeriods     CustomerAccountPeriod[] @relation("CustomerAccountPeriods")
  paymentsCreated    CustomerPayment[]       @relation("CustomerPaymentsCreated")
  paymentsCancelled  CustomerPayment[]       @relation("CustomerPaymentsCancelled")

  @@index([status])
  @@index([customerId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String // ชื่อลูกค้า
  company   String? // บริษัท
  branch    String? // สาขา
  address   String? // ที่อยู่บริษัท
  taxId     String? // เลขประจำตัวผู้เสียภาษี (13 หลัก, เก็บเป็นข้อความเพื่อรักษาศูนย์นำหน้า)
  phone     String? // เบอร์โทรศัพท์
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // เงื่อนไขวางบิลในนามบริษัท (ดู backend/src/billing) - VAT 7% และหัก ณ ที่จ่ายคิดจากทุกรายการที่ไม่ใช่ค่าใบเสร็จกรมขนส่ง
  billingVat             Boolean   @default(true) // false = บิลไม่มี VAT
  billingWhtRate         Decimal   @default(3) @db.Decimal(5, 2) // % หัก ณ ที่จ่ายอัตราปกติ (0 = ไม่หัก)
  billingWhtSpecialRate  Decimal?  @db.Decimal(5, 2) // % อัตราพิเศษชั่วคราว เช่น 1% ถึงสิ้นปี
  billingWhtSpecialUntil DateTime? // วันสุดท้ายที่ใช้อัตราพิเศษ (เทียบกับวันที่ออกบิล) - หลังจากนั้นกลับไปอัตราปกติเอง
  billingCreditDays      Int? // เครดิตเทอม (วัน นับจากวันออกบิล, ผู้ใช้ 2026-09-28: มีรอบรับวางบิลแต่ใช้ค่าคร่าวๆ) - null = ไม่ได้ตั้ง
  // ต้องมีใบเสนอราคาที่ลูกค้าอนุมัติแล้วก่อนวางบิล (ผู้ใช้ 2026-10-01, YM) - ออกบิลได้จากหน้าใบเสนอราคาเท่านั้น
  billingRequiresQuotation Boolean @default(false)

  vehicles        Vehicle[]
  requestedCases  Case[]
  serviceFeeRates ServiceFeeRate[]
  taxRenewals     TaxRenewal[]
  invoices        Invoice[]
  deliverySlips   DeliverySlip[]
  users           User[] // บัญชีลูกค้าที่ล็อกอินเข้า portal ของบริษัทนี้
  accountPeriods  CustomerAccountPeriod[]
  payments        CustomerPayment[]
  plateSwaps      PlateSwap[] // งานสลับเลขที่ลูกค้ารายนี้เป็นเจ้าของงาน (ผู้ใช้ 2026-09-28)
  vehicleUseCancellations VehicleUseCancellation[] // งานยกเลิกการใช้รถที่ลูกค้ารายนี้เป็นเจ้าของงาน (ผู้ใช้ 2026-10-02)
  plateCopies PlateCopy[] // งานคัดแผ่นป้ายทะเบียนที่ลูกค้ารายนี้เป็นเจ้าของงาน (ผู้ใช้ 2026-10-02)
  taxInvoices     TaxInvoice[]
  whtCertificates WhtCertificate[]
  quotations      Quotation[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(1000) // ลำดับแสดงผลที่กำหนดเอง ยี่ห้อที่เพิ่มทีหลังผ่าน "+ เพิ่มยี่ห้อ" จะได้ค่าเริ่มต้นนี้ (ไปท้ายรายการ)
  createdAt DateTime @default(now()) // ใช้ตัดสินลำดับระหว่างยี่ห้อที่ sortOrder เท่ากัน

  vehicles Vehicle[]
}

model Vehicle {
  id                   String   @id @default(cuid())
  date                 DateTime // วันที่
  customerId           String // ชื่อลูกค้า
  // เลขตัวถัง - ไม่ซ้ำเฉพาะในกลุ่มรถที่ยังไม่ถูกลบ (partial unique index "Vehicle_chassis_active_key" ใน
  // migration 20260923120000) ลบรถทิ้งแล้วคีย์เลขตัวถังเดิมเข้ามาใหม่ได้ - ผู้ใช้ 2026-09-23
  // Prisma ไม่รองรับ partial unique index จึงไม่มี @unique ที่นี่ - ห้ามใช้ findUnique({ where: { chassis } })
  chassis              String
  engine               String? // เลขเครื่อง
  brandId              String // ยี่ห้อ
  fuel                 String? // ประเภทเชื้อเพลิง
  cc                   Decimal? @db.Decimal(10, 2) // ขนาด CC
  weight               Decimal? @db.Decimal(10, 2) // น้ำหนักรถ (กก.)
  color                String?
  body                 String? // ประเภทรถ (13 ตัวเลือกที่กำหนด ตรวจสอบระดับ application)
  registrationProvince String? // จังหวัดที่จดทะเบียน
  ownerProvince        String? // จังหวัดเจ้าของรถ

  // Step 2: แจ้งย้าย/ตัดบัญชี confirmation (สถานะคำนวณจาก registrationProvince เอง ไม่ต้องเก็บ)
  transferDone          Boolean   @default(false) // ลูกน้องติ๊กว่าดำเนินการแจ้งย้าย/ตัดบัญชีเรียบร้อยแล้ว
  transferCompletedDate DateTime? // วันที่ดำเนินการเสร็จ
  transferCost          Decimal?  @db.Decimal(10, 2) // ค่าใช้จ่ายจริง (ค่าเริ่มต้นมาจากตาราง FeeDeregistration/FeeRelocate)

  // Step 3: ตรวจรถ - รอบ 1 และรอบ 2 ใช้ช่องชุดเดียวกัน (ส่งตรวจ -> ผลตรวจ) โดย inspectionRound บอกว่า
  // ข้อมูลส่งตรวจ/ผลตรวจชุดปัจจุบันเป็นของรอบไหน ผลตรวจผ่านมีอายุ 90 วัน: ครบ 90 วันจาก inspectionResultDate
  // แล้วยังไม่ได้ยื่นเอกสาร รถเข้าคิวส่งตรวจเองเป็นรอบ 2 (ดู submission-eligibility.ts) ข้อมูลรอบก่อน (หรือครั้งที่ตรวจไม่ผ่าน) ถูกเก็บไว้ใน VehicleEditLog ตอนส่งตรวจใหม่
  inspectionRound Int @default(1) // 1 | 2

  // Step 3a: ส่งตรวจ (เข้าคิวหลังจากทำ Step 2 เสร็จแล้วเท่านั้น - transferDone = true)
  inspectionSentType     String? // 'ส่งตรวจนอก' | 'เอารถมาตรวจเอง'
  inspectionSentDate     DateTime? // วันที่ส่งตรวจ
  inspectionSentCost     Decimal?  @db.Decimal(10, 2) // ราคาตรวจรถ (No bill) - ค่าเริ่มต้นมาจากตาราง FeeInspectionBangkok/FeeInspectionProvince
  inspectionSentBillCost Decimal?  @db.Decimal(10, 2) // ค่าตรวจรถ (Bill) 50 บาท - เฉพาะรอบ 2

  // Step 3b: ผลตรวจ (เข้าคิวหลังจาก inspectionSentDate ถูกกรอกแล้วเท่านั้น)
  inspectionResult         String? // 'ผ่าน' | 'ไม่ผ่าน'
  inspectionResultDate     DateTime? // วันที่ทราบผลตรวจ
  inspectionResultCost     Decimal?  @db.Decimal(10, 2) // ราคาตรวจรถ (No bill) ณ วันทราบผล - ตรวจไม่ผ่านเป็น 0 (ได้เงินคืน)
  inspectionResultBillCost Decimal?  @db.Decimal(10, 2) // ค่าตรวจรถ (Bill) ณ วันทราบผล - เฉพาะรอบ 2, ตรวจไม่ผ่านเป็น 0
  inspectionFailRemark     String? // เหตุผลที่ตรวจไม่ผ่าน - บังคับกรอกเมื่อ inspectionResult = 'ไม่ผ่าน'

  // Step 4: ยื่นเอกสารจดทะเบียน - ใช้คำนวณภาษีประจำปี (ดู GovernmentTax*/VehicleOwner/TaxCalculation ด้านล่าง)
  firstRegistrationDate DateTime? // วันจดทะเบียนครั้งแรก - ใช้คำนวณอายุรถและตรวจสอบมาตรการลดภาษี EV ตามช่วงเวลา
  isFactoryNew          Boolean? // รถใหม่จากโรงงานหรือไม่ - เงื่อนไขของสิทธิ EV บางมาตรการ
  ownerId               String? // เจ้าของรถตามทะเบียน - อาจไม่ใช่คนเดียวกับ customerId (ผู้ส่งงาน) ห้ามอนุมานจากกัน

  // เลขทะเบียนที่ขอ/ได้รับ - แก้ไขได้ตลอด (mutable) ไม่ใช่ snapshot เพราะกรมขนส่งอาจรันเลขให้ทีหลังตอน
  // ใบเสร็จออก (ไม่ทราบตอนยื่นเอกสาร) เก็บแยก 2 คอลัมน์ตามที่ใช้แสดงผล: หมวดทะเบียน (เช่น "4กข", สูงสุด
  // 3 ตัวอักษร) และเลขท้าย (เช่น "4444", สูงสุด 4 หลัก)
  plateCategory String?
  plateNumber   String?

  // Step 6-8 (หลังได้รับใบเสร็จ): รับป้ายทะเบียน / รับเล่มทะเบียน / Delivery - วันที่ไม่ว่าง = ดำเนินการแล้ว
  // (คิวของแต่ละขั้นและเงื่อนไขก่อนหน้าอยู่ใน backend/src/receiving/receiving.service.ts)
  plateReceivedDate   DateTime?
  platePhotoId        String? // รูปป้ายที่ใช้ยืนยันการรับป้าย (บังคับทุกคัน - แนบรายคันจากคิว ไม่ใช้ AI แล้ว ผู้ใช้ 2026-09-26)
  bookReceivedDate    DateTime?
  bookPhotoId         String? // รูปเล่มที่ใช้ยืนยันการรับเล่ม (บังคับทุกคัน - แนบรายคันจากคิว ไม่ใช้ AI แล้ว ผู้ใช้ 2026-09-26)
  deliveredDate       DateTime?
  deliveryRecipient   String? // ผู้รับของ Delivery
  deliveryNote        String?
  // ส่งงาน = ส่งเล่ม (deliveredDate) ป้ายส่งพร้อมกันถ้ารับป้ายแล้ว ถ้าป้ายยังไม่ออกจะส่งตามทีหลัง
  // ใบเสร็จไม่ได้ส่งไปกับงานแล้ว (ผู้ใช้ 2026-09-26) ส่งให้ลูกค้าพร้อมใบวางบิล แต่ต้องได้ใบเสร็จก่อนจึงส่งงานได้
  // plateDeliveredDate ว่าง ทั้งที่ deliveredDate ไม่ว่าง = ป้ายค้างส่ง (ดู backend/src/delivery)
  plateDeliveredDate  DateTime?
  // ลูกค้ากดยืนยันรับของใน portal (ดู backend/src/portal) - ไม่บังคับ พนักงานยังปิดงานได้โดยไม่ต้องรอ
  deliveryConfirmedAt DateTime?

  // ปิดงาน - วางบิลนอกระบบ (ผู้ใช้ 2026-09-27): รถที่ส่งงานแล้วแต่วางบิลนอกระบบ (บัญชีส่วนตัว / Google Sheet / เหมาจ่าย)
  // ADMIN/ACCOUNTANT ปิดพร้อมหมายเหตุ -> ออกจากคิวรอวางบิล ยอดค้างรับในภาพรวม และสถานะรอ "วางบิล" ในหน้าค้นหารถ
  // billingClosedAt ไม่ว่าง = ปิดแล้ว ADMIN เปิดกลับได้พร้อมเหตุผล (ล้างทั้ง 3 ช่อง) ทุกครั้งที่ปิด/เปิดบันทึกลง VehicleEditLog
  billingClosedAt   DateTime?
  billingClosedNote String? // หมายเหตุตอนปิด เช่น วางบิลที่ไหน เลขที่อะไร - บังคับกรอกที่ระดับ service
  billingClosedById String? // ผู้ใช้ที่กดปิดงาน

  // ลบข้อมูลรถ (soft delete - ผู้ใช้ 2026-09-23): ADMIN เท่านั้น ต้องระบุเหตุผลทุกครั้ง และลบได้เฉพาะรถที่ยัง
  // ไม่ยื่นเอกสารจดทะเบียน (ดู VehiclesService.deleteVehicle) deletedAt ไม่ว่าง = ถูกลบแล้ว ซ่อนจากทุกหน้าจอ
  // และทุกคิว แต่ยังอยู่ในฐานข้อมูลและ ADMIN กู้คืนได้ - ทุกครั้งที่ลบ/กู้คืนบันทึกลง VehicleEditLog ด้วย
  deletedAt     DateTime?
  deletedReason String? // เหตุผลที่ลบ (Remark) - บังคับกรอกที่ระดับ service
  deletedById   String? // ผู้ใช้ที่กดลบ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer            Customer              @relation(fields: [customerId], references: [id])
  deletedBy           User?                 @relation("DeletedVehicles", fields: [deletedById], references: [id])
  billingClosedBy     User?                 @relation("VehicleBillingClosures", fields: [billingClosedById], references: [id], onDelete: SetNull)
  brand               Brand                 @relation(fields: [brandId], references: [id])
  owner               VehicleOwner?         @relation(fields: [ownerId], references: [id])
  platePhoto          PlatePhoto?           @relation(fields: [platePhotoId], references: [id], onDelete: SetNull)
  bookPhoto           BookPhoto?            @relation(fields: [bookPhotoId], references: [id], onDelete: SetNull)
  invoiceLines        InvoiceLine[]
  paymentLines        CustomerPaymentLine[]
  cases               Case[]
  editLogs            VehicleEditLog[]
  taxCalculations     TaxCalculation[]
  documentSubmissions DocumentSubmission[]
  plateSwapsAsNew     PlateSwap[] // งานสลับเลขที่รถคันนี้เป็น "รถใหม่" ที่รับเลขจากรถเก่า
  taxRenewals         TaxRenewal[]
  deliverySlipItems   DeliverySlipItem[]

  @@index([customerId])
  @@index([brandId])
  @@index([ownerId])
  @@index([chassis])
  @@index([deletedAt])
}

// แก้ไขข้อมูลรถจดใหม่หลังบันทึกแล้ว ต้องระบุเหตุผล (remark) ทุกครั้ง - บังคับที่ระดับ service
model VehicleEditLog {
  id         String   @id @default(cuid())
  vehicleId  String
  remark     String // เหตุผลที่แก้ไข
  changes    String // JSON: { field: { from, to } } เฉพาะฟิลด์ที่เปลี่ยนจริง
  editedAt   DateTime @default(now())
  // ผู้ใช้ที่แก้ (ผู้ใช้ 2026-09-24) - แถวก่อนหน้านี้ และงานที่รันนอกคำขอ HTTP (script) เป็น null
  editedById String?

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  editedBy User?   @relation("VehicleEdits", fields: [editedById], references: [id], onDelete: SetNull)

