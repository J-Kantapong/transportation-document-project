// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum DocumentType {
  NEW_REGISTRATION // จดทะเบียนรถใหม่
  PLATE_SWAP // สลับเลขทะเบียน
  TRANSFER // โอนรถ
  ADDRESS_CHANGE // แจ้งย้าย
  OTHER // งานทะเบียนอื่นๆ
}

enum CaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases Case[] @relation("AssignedStaff")
}

model Customer {
  id        String   @id @default(cuid())
  name      String // ชื่อลูกค้า
  company   String? // บริษัท
  branch    String? // สาขา
  address   String? // ที่อยู่บริษัท
  taxId     String? // เลขประจำตัวผู้เสียภาษี (13 หลัก, เก็บเป็นข้อความเพื่อรักษาศูนย์นำหน้า)
  phone     String? // เบอร์โทรศัพท์
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles       Vehicle[]
  requestedCases Case[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(1000) // ลำดับแสดงผลที่กำหนดเอง ยี่ห้อที่เพิ่มทีหลังผ่าน "+ เพิ่มยี่ห้อ" จะได้ค่าเริ่มต้นนี้ (ไปท้ายรายการ)
  createdAt DateTime @default(now()) // ใช้ตัดสินลำดับระหว่างยี่ห้อที่ sortOrder เท่ากัน

  vehicles Vehicle[]
}

model Vehicle {
  id                   String   @id @default(cuid())
  date                 DateTime // วันที่
  customerId           String // ชื่อลูกค้า
  chassis              String   @unique // เลขตัวถัง
  engine               String? // เลขเครื่อง
  brandId              String // ยี่ห้อ
  fuel                 String? // ประเภทเชื้อเพลิง
  cc                   Decimal? @db.Decimal(10, 2) // ขนาด CC
  weight               Decimal? @db.Decimal(10, 2) // น้ำหนักรถ (กก.)
  color                String?
  body                 String? // ประเภทรถ (13 ตัวเลือกที่กำหนด ตรวจสอบระดับ application)
  registrationProvince String? // จังหวัดที่จดทะเบียน
  ownerProvince        String? // จังหวัดเจ้าของรถ

  // Step 2: แจ้งย้าย/ตัดบัญชี confirmation (สถานะคำนวณจาก registrationProvince เอง ไม่ต้องเก็บ)
  transferDone          Boolean   @default(false) // ลูกน้องติ๊กว่าดำเนินการแจ้งย้าย/ตัดบัญชีเรียบร้อยแล้ว
  transferCompletedDate DateTime? // วันที่ดำเนินการเสร็จ
  transferCost          Decimal?  @db.Decimal(10, 2) // ค่าใช้จ่ายจริง (ค่าเริ่มต้นมาจากตาราง FeeDeregistration/FeeRelocate)

  // Step 3: ตรวจรถ - รอบ 1 และรอบ 2 ใช้ช่องชุดเดียวกัน (ส่งตรวจ -> ผลตรวจ) โดย inspectionRound บอกว่า
  // ข้อมูลส่งตรวจ/ผลตรวจชุดปัจจุบันเป็นของรอบไหน ผลตรวจผ่านมีอายุ 90 วัน: ครบ 90 วันจาก inspectionResultDate
  // แล้วยังไม่ได้ยื่นเอกสาร รถเข้าคิวส่งตรวจเองเป็นรอบ 2 (ดู submission-eligibility.ts) ข้อมูลรอบก่อน (หรือครั้งที่ตรวจไม่ผ่าน) ถูกเก็บไว้ใน VehicleEditLog ตอนส่งตรวจใหม่
  inspectionRound Int @default(1) // 1 | 2

  // Step 3a: ส่งตรวจ (เข้าคิวหลังจากทำ Step 2 เสร็จแล้วเท่านั้น - transferDone = true)
  inspectionSentType     String? // 'ส่งตรวจนอก' | 'เอารถมาตรวจเอง'
  inspectionSentDate     DateTime? // วันที่ส่งตรวจ
  inspectionSentCost     Decimal?  @db.Decimal(10, 2) // ราคาตรวจรถ (No bill) - ค่าเริ่มต้นมาจากตาราง FeeInspectionBangkok/FeeInspectionProvince
  inspectionSentBillCost Decimal?  @db.Decimal(10, 2) // ค่าตรวจรถ (Bill) 50 บาท - เฉพาะรอบ 2

  // Step 3b: ผลตรวจ (เข้าคิวหลังจาก inspectionSentDate ถูกกรอกแล้วเท่านั้น)
  inspectionResult     String? // 'ผ่าน' | 'ไม่ผ่าน'
  inspectionResultDate DateTime? // วันที่ทราบผลตรวจ
  inspectionResultCost Decimal?  @db.Decimal(10, 2) // ราคาตรวจรถ (No bill) ณ วันทราบผล - ตรวจไม่ผ่านเป็น 0 (ได้เงินคืน)
  inspectionResultBillCost Decimal? @db.Decimal(10, 2) // ค่าตรวจรถ (Bill) ณ วันทราบผล - เฉพาะรอบ 2, ตรวจไม่ผ่านเป็น 0
  inspectionFailRemark String? // เหตุผลที่ตรวจไม่ผ่าน - บังคับกรอกเมื่อ inspectionResult = 'ไม่ผ่าน'

  // Step 4: ยื่นเอกสารจดทะเบียน - ใช้คำนวณภาษีประจำปี (ดู GovernmentTax*/VehicleOwner/TaxCalculation ด้านล่าง)
  firstRegistrationDate DateTime? // วันจดทะเบียนครั้งแรก - ใช้คำนวณอายุรถและตรวจสอบมาตรการลดภาษี EV ตามช่วงเวลา
  isFactoryNew          Boolean? // รถใหม่จากโรงงานหรือไม่ - เงื่อนไขของสิทธิ EV บางมาตรการ
  ownerId               String? // เจ้าของรถตามทะเบียน - อาจไม่ใช่คนเดียวกับ customerId (ผู้ส่งงาน) ห้ามอนุมานจากกัน

  // เลขทะเบียนที่ขอ/ได้รับ - แก้ไขได้ตลอด (mutable) ไม่ใช่ snapshot เพราะกรมขนส่งอาจรันเลขให้ทีหลังตอน
  // ใบเสร็จออก (ไม่ทราบตอนยื่นเอกสาร) เก็บแยก 2 คอลัมน์ตามที่ใช้แสดงผล: หมวดทะเบียน (เช่น "4กข", สูงสุด
  // 3 ตัวอักษร) และเลขท้าย (เช่น "4444", สูงสุด 4 หลัก)
  plateCategory String?
  plateNumber   String?

  // Step 6-8 (หลังได้รับใบเสร็จ): รับป้ายทะเบียน / รับเล่มทะเบียน / Delivery - วันที่ไม่ว่าง = ดำเนินการแล้ว
  // (คิวของแต่ละขั้นและเงื่อนไขก่อนหน้าอยู่ใน backend/src/receiving/receiving.service.ts)
  plateReceivedDate DateTime?
  platePhotoId      String? // รูปป้ายที่ใช้ยืนยันการรับป้าย (AI อ่านเลขทะเบียนแล้วจับคู่ - ดู PlatePhoto)
  bookReceivedDate  DateTime?
  deliveredDate     DateTime?
  deliveryRecipient String? // ผู้รับของ Delivery
  deliveryNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id])
  brand               Brand                @relation(fields: [brandId], references: [id])
  owner               VehicleOwner?        @relation(fields: [ownerId], references: [id])
  platePhoto          PlatePhoto?          @relation(fields: [platePhotoId], references: [id], onDelete: SetNull)
  cases               Case[]
  editLogs            VehicleEditLog[]
  taxCalculations     TaxCalculation[]
  documentSubmissions DocumentSubmission[]

  @@index([customerId])
  @@index([brandId])
  @@index([ownerId])
}

// แก้ไขข้อมูลรถจดใหม่หลังบันทึกแล้ว ต้องระบุเหตุผล (remark) ทุกครั้ง - บังคับที่ระดับ service
model VehicleEditLog {
  id        String   @id @default(cuid())
  vehicleId String
  remark    String // เหตุผลที่แก้ไข
  changes   String // JSON: { field: { from, to } } เฉพาะฟิลด์ที่เปลี่ยนจริง
  editedAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Case {
  id           String       @id @default(cuid())
  caseNumber   String       @unique // เลขที่เรื่อง
  documentType DocumentType
  status       CaseStatus   @default(PENDING)
  notes        String?
  submittedAt  DateTime     @default(now())
  completedAt  DateTime?

  vehicleId       String
  requesterId     String
  assignedStaffId String?

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  requester     Customer @relation(fields: [requesterId], references: [id])
  assignedStaff User?    @relation("AssignedStaff", fields: [assignedStaffId], references: [id])

  transferDetail      TransferDetail?
  plateSwapDetail     PlateSwapDetail?
  addressChangeDetail AddressChangeDetail?
  documents           CaseDocument[]

  @@index([vehicleId])
  @@index([requesterId])
  @@index([assignedStaffId])
  @@index([status])
}

model TransferDetail {
  id           String   @id @default(cuid())
  caseId       String   @unique
  fromOwnerId  String
  toOwnerId    String
  transferDate DateTime
  price        Decimal? @db.Decimal(12, 2)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model PlateSwapDetail {
  id             String   @id @default(cuid())
  caseId         String   @unique
  oldPlateNumber String
  newPlateNumber String
  swapDate       DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AddressChangeDetail {
  id            String   @id @default(cuid())
  caseId        String   @unique
  oldAddress    String
  newAddress    String
  effectiveDate DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id         String   @id @default(cuid())
  caseId     String
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// --- Fee master/reference tables -------------------------------------------------
// Ported from the user's registration fee pricing spec (Excel workbook committed at
// prototype/sites-reference/docs/vehicle_registration_pricing_db.xlsx). vehicleType/brand/
// province are free-text keys validated at the application level against
// src/vehicles/vehicle-reference-data.ts (VEHICLE_TYPES, PROVINCES), matching how
// Vehicle.body/registrationProvince/ownerProvince already work — no new enum/FK needed.
// Amounts are the No bill / Bill totals used at each step of the registration workflow
// (ตัดบัญชี/แจ้งย้าย, ตรวจรถ, ยื่นเอกสารจดทะเบียน). Nullable amount = not yet provided by the
// user; do not guess a value, leave it for them to fill in.

model FeeDeregistration {
  id          String  @id @default(cuid())
  vehicleType String // ประเภทรถ (รวมรายการพิเศษ "นำรถมาตรวจ")
  brand       String  @default("อื่นๆ") // ยี่ห้อ (แยกเฉพาะ รย.1-เก๋ง 2 ตอน)
  amount      Decimal @db.Decimal(10, 2) // ค่าตัดบัญชี (บาท, No bill)

  @@unique([vehicleType, brand])
}

model FeeRelocate {
  id           String  @id @default(cuid())
  vehicleType  String
  brand        String  @default("อื่นๆ")
  noBillAmount Decimal @db.Decimal(10, 2) // ค่าแจ้งย้าย (No bill)
  billAmount   Decimal @default(5) @db.Decimal(10, 2) // ค่าแจ้งย้าย (Bill, คงที่ 5 บาท/คัน)

  @@unique([vehicleType, brand])
}

model FeeInspectionBangkok {
  id          String  @id @default(cuid())
  vehicleType String
  brand       String  @default("อื่นๆ")
  amount      Decimal @db.Decimal(10, 2) // ค่าตรวจรถ กทม. (เฉพาะกรณีตัดบัญชี)

  @@unique([vehicleType, brand])
}

model FeeInspectionProvince {
  id          String   @id @default(cuid())
  province    String
  vehicleType String
  amount      Decimal? @db.Decimal(10, 2) // ยังไม่มีข้อมูลครบทุกจังหวัด - null จนกว่าผู้ใช้จะให้ราคา

  @@unique([province, vehicleType])
}

model FeeCarBillParam {
  id     String   @id @default(cuid())
  key    String   @unique // รายการ เช่น "ค่าคำขอ (ปกติ)"
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeCarNoBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeMotorcycleBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeMotorcycleNoBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

// --- Government annual vehicle tax (ภาษีรถประจำปี, กรมการขนส่งทางบก) -------------------
// Per the user's Step 4 spec: never combine these with the Fee*/company service-fee
// tables above - this is government tax only. vehicleFamily groups Vehicle.body by its
// รย. prefix (RY1/RY2/RY3/RY12), which is coarser than the vehicleType strings the Fee*
// tables use above; in particular the รย.12-<cc range> VEHICLE_TYPES entries are cc
// brackets for company service-fee pricing only and must NOT be reused to look up this
// government tax (ICE motorcycle tax is a flat rate regardless of cc). fuelGroup buckets
// Vehicle.fuel: ICE = เบนซิน/ดีเซล/LPG/NGV, HEV = ไฮบริด (HEV), PHEV = ปลั๊กอินไฮบริด (PHEV),
// BEV = ไฟฟ้า (BEV). See src/tax/government-tax-reference-data.ts for the classifier that
// derives vehicleFamily/fuelGroup from a Vehicle row.
//
// Governance (status/active/legalReference): every rate row is DRAFT + inactive by default
// so a row someone adds without review can never silently compute a real tax figure -
// TaxService only loads rows where active=true AND status=VERIFIED. "VERIFIED" here means
// the user has explicitly confirmed the figure in conversation with an agent (this repo's
// working pattern - see memory/project_fee_pricing_workflow.md), NOT that a legal citation
// URL has been attached; legalReference is free text for whoever wants to note a source
// later, never required to flip status to VERIFIED. When the user gives a new/changed rate,
// update the row AND its status/active explicitly - do not assume a prior VERIFIED row stays
// correct forever, and do not mark a new row VERIFIED without the user confirming the number.

enum GovTaxVehicleFamily {
  RY1 // รถยนต์นั่งส่วนบุคคลไม่เกิน 7 คน
  RY2 // รถยนต์นั่งส่วนบุคคลเกิน 7 คน
  RY3 // รถยนต์บรรทุกส่วนบุคคล
  RY12 // รถจักรยานยนต์
}

enum GovTaxFuelGroup {
  ICE
  HEV
  PHEV
  BEV
}

enum GovTaxRuleStatus {
  DRAFT // ยังไม่ได้ยืนยันกับผู้ใช้ - ห้ามใช้คำนวณยอดจริง
  VERIFIED // ผู้ใช้ยืนยันตัวเลขนี้แล้ว (ผ่านแชต ไม่บังคับเอกสารกฎหมาย)
}

model GovernmentTaxCcBracket {
  id             String              @id @default(cuid())
  vehicleFamily  GovTaxVehicleFamily // ปัจจุบันใช้กับ RY1 เท่านั้น (ICE/HEV/PHEV คำนวณแบบ progressive ตาม CC)
  fuelGroup      GovTaxFuelGroup
  ccFrom         Decimal             @db.Decimal(10, 2) // cc เริ่มต้นของขั้นนี้ (รวม)
  ccTo           Decimal?            @db.Decimal(10, 2) // cc สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด (ขั้นบนสุด)
  ratePerCc      Decimal             @db.Decimal(10, 4) // บาท/cc เฉพาะส่วนที่อยู่ในขั้นนี้ (ไม่ใช่สะสมทั้งคัน)
  sortOrder      Int                 @default(0)
  status         GovTaxRuleStatus    @default(DRAFT)
  active         Boolean             @default(false)
  legalReference String?

  @@unique([vehicleFamily, fuelGroup, ccFrom])
}

model GovernmentTaxWeightBracket {
  id             String              @id @default(cuid())
  vehicleFamily  GovTaxVehicleFamily // RY1 (เฉพาะ fuelGroup = BEV), RY2, RY3
  fuelGroup      GovTaxFuelGroup? // null = ใช้ได้ทุกเชื้อเพลิงในกลุ่มนี้ (RY2/RY3 ไม่แยกตามเชื้อเพลิง); RY1 ต้องระบุ BEV
  weightFrom     Decimal             @db.Decimal(10, 2) // น้ำหนัก (กก.) เริ่มต้นของขั้นนี้ (รวม)
  weightTo       Decimal?            @db.Decimal(10, 2) // น้ำหนัก (กก.) สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด
  amount         Decimal?            @db.Decimal(10, 2) // ภาษี/ปี (บาท) - ยังไม่มีข้อมูล รอผู้ใช้ให้ตาราง EV_WEIGHT_TAX_TABLE / RY2_WEIGHT_TAX_TABLE / RY3_WEIGHT_TAX_TABLE
  sortOrder      Int                 @default(0)
  status         GovTaxRuleStatus    @default(DRAFT)
  active         Boolean             @default(false)
  legalReference String?

  @@unique([vehicleFamily, fuelGroup, weightFrom])
}

model GovernmentTaxEvIncentive {
  id              String              @id @default(cuid())
  vehicleFamily   GovTaxVehicleFamily // เช่น RY1 (รถยนต์ไฟฟ้า)
  label           String // ชื่อมาตรการ เช่น "มาตรการลดภาษีรถ EV ปีงบประมาณ 2569"
  effectiveFrom   DateTime // เทียบกับ Vehicle.firstRegistrationDate
  effectiveTo     DateTime?
  discountPercent Decimal?            @db.Decimal(5, 2) // % ที่ลดจากภาษีที่คำนวณได้จาก GovernmentTaxWeightBracket - ยังไม่มีข้อมูล ห้าม hard-code
  note            String?
  status          GovTaxRuleStatus    @default(DRAFT)
  active          Boolean             @default(false)
  legalReference  String?
}

model GovernmentTaxMotorcycleFlat {
  id             String           @id @default(cuid())
  fuelGroup      GovTaxFuelGroup  @unique // ICE = 100 บาท/ปีทุก cc (ตามกฎ); BEV = กฎรถจักรยานยนต์ไฟฟ้าแยกต่างหาก ยังไม่มีข้อมูล
  amount         Decimal?         @db.Decimal(10, 2)
  note           String?
  status         GovTaxRuleStatus @default(DRAFT)
  active         Boolean          @default(false)
  legalReference String?
}

// --- เจ้าของรถ (VehicleOwner) และ snapshot ผลคำนวณภาษี (TaxCalculation) ------------------
// VehicleOwner is deliberately separate from Customer: the customer submitting the
// paperwork (Vehicle.customerId) is not necessarily the vehicle's registered owner - never
// infer one from the other. juristicMultiplier's hire-purchase exception depends on
// isHirePurchaseBusiness/hirerType on THIS record, matching the vehicle at hand, not a
// permanent trait of the customer.
enum OwnerType {
  INDIVIDUAL // บุคคลธรรมดา
  JURISTIC // นิติบุคคล
}

model VehicleOwner {
  id                     String     @id @default(cuid())
  name                   String?
  ownerType              OwnerType
  isHirePurchaseBusiness Boolean    @default(false) // ประกอบธุรกิจเช่าซื้อหรือไม่ - ใช้เฉพาะเมื่อ ownerType = JURISTIC
  hirerType              OwnerType? // ผู้เช่าซื้อรถคันนี้ - null เมื่อไม่ใช่กรณีเช่าซื้อ หรือบริษัทเช่าซื้อใช้รถเอง
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  vehicles Vehicle[]
}

// Immutable audit snapshot: การคำนวณใหม่สร้างแถวใหม่เสมอ ไม่ update ของเดิม (เหมือน VehicleEditLog)
model TaxCalculation {
  id                       String               @id @default(cuid())
  vehicleId                String
  status                   String // CALCULATED | MISSING_INPUT | MISSING_VERIFIED_RULE
  vehicleFamily            GovTaxVehicleFamily?
  fuelGroup                GovTaxFuelGroup?
  baseAmount               Decimal?             @db.Decimal(12, 2)
  incentiveDiscountPercent Decimal?             @db.Decimal(5, 2)
  juristicMultiplier       Int                  @default(1)
  finalAmount              Decimal?             @db.Decimal(12, 2) // null = ยังคำนวณภาษีไม่ได้ (ห้ามแสดง 0 บาทแทน)
  reason                   String? // เหตุผลที่คำนวณไม่ได้ (ถ้ามี)
  inputSnapshot            Json
  breakdown                Json
  createdAt                DateTime             @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// --- ยื่นเอกสารจดทะเบียนรถใหม่ (Step 4) - snapshot ค่าธรรมเนียม Bill/No bill ------------
// Audit snapshot เหมือน TaxCalculation ข้างบน: การยื่นเอกสารแต่ละครั้งสร้างแถวใหม่เสมอ ไม่ update ของเดิม
// billItems/noBillItems เก็บ breakdown ที่คำนวณจริง ณ ตอนยื่น (จาก FeeCarBillParam/FeeCarNoBillParam/
// FeeMotorcycleBillParam/FeeMotorcycleNoBillParam) กันไม่ให้ประวัติเปลี่ยนไปตามอัตราที่อาจแก้ในอนาคต
// taxAmount คัดลอกมาจาก TaxCalculation.finalAmount ล่าสุด ณ ตอนยื่น (อาจ null ถ้ายังคำนวณภาษีไม่ได้) เพื่อให้
// หน้า records-by-date โชว์ยอดรวมได้โดยไม่ต้อง join ย้อนกลับไปหา TaxCalculation
//
// status เป็นข้อยกเว้นเดียวที่ mutable (ทุกฟิลด์อื่นเป็น snapshot คงที่ตลอดไป): PENDING (ค่าเริ่มต้น - ยื่น
// แล้ว รอใบเสร็จจากกรมขนส่ง) -> RECEIPT_RECEIVED (ได้รับใบเสร็จแล้ว) หรือ FAILED (ยื่นไม่สำเร็จ ต้องแก้ไข/
// ยื่นใหม่) เปลี่ยนได้ครั้งเดียวจาก PENDING เท่านั้น (ดู DocumentSubmissionService.updateStatus) รถคันหนึ่ง
// จะยื่นเอกสารซ้ำไม่ได้ตราบใดที่ยังมี DocumentSubmission ล่าสุดค้างสถานะ PENDING อยู่ (บังคับใน
// DocumentSubmissionService.submit() กันยื่นซ้ำโดยไม่ได้ตั้งใจระหว่างรอกรมขนส่งดำเนินการ)
model DocumentSubmission {
  id                  String    @id @default(cuid())
  vehicleId           String
  submitDate          DateTime // วันที่ยื่นเอกสาร (ล็อกจากวันที่ตั้งไว้ตอนเริ่ม session ฝั่ง UI)
  status              String    @default("PENDING") // PENDING | RECEIPT_RECEIVED | FAILED - มี PENDING/RECEIPT_RECEIVED = ยื่นซ้ำไม่ได้ (RECEIPT_RECEIVED = จดทะเบียนแล้ว ตลอดไป)
  receiptReceivedDate DateTime? // วันที่ได้รับใบเสร็จ (ตั้งตอน status -> RECEIPT_RECEIVED)
  receiptAmount       Decimal?  @db.Decimal(12, 2) // ยอดที่เห็นบนใบเสร็จจริง (พนักงานกรอก) - เทียบกับ Bill = billFeeTotal + taxAmount
  receiptNo           String? // เลขที่ใบเสร็จ ("เลขที่" มุมขวาบน เช่น 69/0035358) - AI กรอกให้ พนักงานแก้ได้ ใช้เรียงตอนไปห้องรับป้าย
  failRemark          String? // เหตุผลที่ยื่นไม่สำเร็จ - บังคับกรอกตอน status -> FAILED แล้วรถกลับไปทำ Step 4 ใหม่ได้
  receiptCarriedAt    DateTime? // ตรวจใบยื่นแล้วยังไม่ได้ใบเสร็จและยังไม่รู้สาเหตุ -> ย้ายไป "ค้างจากใบก่อน" (ยัง PENDING)
  plateNumberOption   String // NONE | NORMAL | AUCTION
  includePlateFee     Boolean   @default(true)
  newPlateOption      String? // NONE | BLACKWHITE | AUCTION - รถยนต์เท่านั้น, null สำหรับมอเตอร์ไซค์
  relocateAddon       Boolean   @default(false) // แจ้งย้ายออกต่างจังหวัดพร้อมกัน - รถยนต์เท่านั้น
  stopUseRelocateOut  Boolean   @default(false) // จดใหม่ หยุดใช้ย้ายออก (ลงขัน 250 บาท) - มอเตอร์ไซค์เท่านั้น
  urgent              Boolean   @default(false)
  billItems           Json // snapshot [{label, amount}] ไม่รวมภาษี
  noBillItems         Json
  billFeeTotal        Decimal   @db.Decimal(12, 2)
  noBillTotal         Decimal   @db.Decimal(12, 2)
  taxAmount           Decimal?  @db.Decimal(12, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vehicle  Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  receipts ReceiptImage[]

  @@index([vehicleId])
  @@index([submitDate])
}

// --- รูปใบเสร็จ (หน้ารับใบเสร็จ) ---------------------------------------------------
// เก็บรูปใบเสร็จไว้อ้างอิงตอนวางบิลลูกค้า ตัวไฟล์อยู่ใน storage (ตอนนี้ดิสก์ในเครื่อง ต่อไป Cloudflare R2)
// ตารางนี้เก็บแค่ key ของไฟล์ + ผลที่อ่านได้. submissionId null = อัปโหลดแบบหลายใบแล้วยังไม่ได้จับคู่กับรถ.
// รายการยื่นหนึ่งรายการมีได้หลายรูป (ถ่ายใหม่ / ใบเสร็จหลายแผ่น).
model ReceiptImage {
  id               String   @id @default(cuid())
  submissionId     String?
  storageKey       String   @unique
  mimeType         String
  sizeBytes        Int
  originalName     String?
  extractionSource String   @default("NONE") // NONE = ยังไม่ได้ใช้ AI อ่าน | model id ของ AI ที่อ่าน
  extraction       Json? // ผลที่ AI อ่านได้ - รูปแบบจะกำหนดหลังเห็นใบเสร็จจริง
  createdAt        DateTime @default(now())

  submission DocumentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

// --- งานแจ้งย้ายยามาฮ่า (Yamaha relocation notice) --------------------------------
// Standalone log - not linked to Customer/Vehicle. One row = one day's notice batch for
// one size (size splits the two UI pages รถเล็ก/รถใหญ่). count is the number of vehicles
// that day; every vehicle carries both a Bill portion and a No bill portion of the fee
// (not an either/or choice per vehicle), so billFee/noBillFee are both derived from the
// same count. Fees are snapshotted at creation time from the fixed rates in
// src/yamaha-relocation/yamaha-relocation-fee.ts, so a future rate change never rewrites
// history: รถเล็ก Bill 5 บาท/คัน, No bill 10 บาท/คัน — รถใหญ่ Bill 5 บาท/คัน, No bill 20 บาท/คัน.
// The fee split is bookkeeping only - not shown in the UI, per the user's instruction.

enum YamahaRelocationSize {
  SMALL // รถเล็ก
  LARGE // รถใหญ่
}

model YamahaRelocationEntry {
  id        String               @id @default(cuid())
  date      DateTime // วันที่แจ้งย้าย
  size      YamahaRelocationSize
  count     Int // จำนวนคันในวันนั้น
  billFee   Decimal              @db.Decimal(10, 2) // count x อัตรา Bill ณ ตอนบันทึก
  noBillFee Decimal              @db.Decimal(10, 2) // count x อัตรา No bill ณ ตอนบันทึก
  createdAt DateTime             @default(now())

  @@index([size, date])
}

// --- รูปป้ายทะเบียน (หน้ารับป้ายทะเบียน Step 6) ------------------------------------
// พนักงานถ่ายรูปป้ายที่ได้รับ (รูปเดียวมีได้หลายแผ่น) -> AI อ่านเลขทะเบียน -> ระบบจับคู่กับรถที่รอรับป้าย
// จากทะเบียนที่รู้แล้วใน Step 5 (Vehicle.plateCategory/plateNumber). extraction เก็บแค่ผลอ่าน ส่วนการจับคู่
// คำนวณใหม่ทุกครั้งที่เปิดดู (คิวเปลี่ยนได้). AI ไม่บันทึกเอง - พนักงานกดยืนยันแล้วจึงตั้ง Vehicle.plateReceivedDate
// พร้อม Vehicle.platePhotoId เป็นหลักฐาน. closedAt ไม่ว่าง = ยืนยัน/ปิดรูปนี้แล้ว ไม่แสดงในถาดรอยืนยัน
model PlatePhoto {
  id               String    @id @default(cuid())
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  originalName     String?
  extractionSource String    @default("NONE") // NONE = ไม่ได้ใช้ AI | model id ของ AI ที่อ่าน
  extraction       Json? // { plates: [...], usage } หรือ { error }
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  vehicles Vehicle[]

  @@index([closedAt])
}
