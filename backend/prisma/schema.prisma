// --- Government annual vehicle tax (ภาษีรถประจำปี, กรมการขนส่งทางบก) -------------------
// Per the user's Step 4 spec: never combine these with the Fee*/company service-fee
// tables above - this is government tax only. vehicleFamily groups Vehicle.body by its
// รย. prefix (RY1/RY2/RY3/RY12), which is coarser than the vehicleType strings the Fee*
// tables use above; in particular the รย.12-<cc range> VEHICLE_TYPES entries are cc
// brackets for company service-fee pricing only and must NOT be reused to look up this
// government tax (ICE motorcycle tax is a flat rate regardless of cc). fuelGroup buckets
// Vehicle.fuel: ICE = เบนซิน/ดีเซล/LPG/NGV, HEV = ไฮบริด (HEV), PHEV = ปลั๊กอินไฮบริด (PHEV),
// BEV = ไฟฟ้า (BEV). See src/tax/government-tax-reference-data.ts for the classifier that
// derives vehicleFamily/fuelGroup from a Vehicle row.
//
// Governance (status/active/legalReference): every rate row is DRAFT + inactive by default
// so a row someone adds without review can never silently compute a real tax figure -
// TaxService only loads rows where active=true AND status=VERIFIED. "VERIFIED" here means
// the user has explicitly confirmed the figure in conversation with an agent (this repo's
// working pattern - see memory/project_fee_pricing_workflow.md), NOT that a legal citation
// URL has been attached; legalReference is free text for whoever wants to note a source
// later, never required to flip status to VERIFIED. When the user gives a new/changed rate,
// update the row AND its status/active explicitly - do not assume a prior VERIFIED row stays
// correct forever, and do not mark a new row VERIFIED without the user confirming the number.

enum GovTaxVehicleFamily {
  RY1 // รถยนต์นั่งส่วนบุคคลไม่เกิน 7 คน
  RY2 // รถยนต์นั่งส่วนบุคคลเกิน 7 คน
  RY3 // รถยนต์บรรทุกส่วนบุคคล
  RY12 // รถจักรยานยนต์
}

enum GovTaxFuelGroup {
  ICE
  HEV
  PHEV
  BEV
}

enum GovTaxRuleStatus {
  DRAFT // ยังไม่ได้ยืนยันกับผู้ใช้ - ห้ามใช้คำนวณยอดจริง
  VERIFIED // ผู้ใช้ยืนยันตัวเลขนี้แล้ว (ผ่านแชต ไม่บังคับเอกสารกฎหมาย)
}

model GovernmentTaxCcBracket {
  id             String              @id @default(cuid())
  vehicleFamily  GovTaxVehicleFamily // ปัจจุบันใช้กับ RY1 เท่านั้น (ICE/HEV/PHEV คำนวณแบบ progressive ตาม CC)
  fuelGroup      GovTaxFuelGroup
  ccFrom         Decimal             @db.Decimal(10, 2) // cc เริ่มต้นของขั้นนี้ (รวม)
  ccTo           Decimal?            @db.Decimal(10, 2) // cc สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด (ขั้นบนสุด)
  ratePerCc      Decimal             @db.Decimal(10, 4) // บาท/cc เฉพาะส่วนที่อยู่ในขั้นนี้ (ไม่ใช่สะสมทั้งคัน)
  sortOrder      Int                 @default(0)
  status         GovTaxRuleStatus    @default(DRAFT)
  active         Boolean             @default(false)
  legalReference String?

  @@unique([vehicleFamily, fuelGroup, ccFrom])
}

model GovernmentTaxWeightBracket {
  id             String              @id @default(cuid())
  vehicleFamily  GovTaxVehicleFamily // RY1 (เฉพาะ fuelGroup = BEV), RY2, RY3
  fuelGroup      GovTaxFuelGroup? // null = ใช้ได้ทุกเชื้อเพลิงในกลุ่มนี้ (RY2/RY3 ไม่แยกตามเชื้อเพลิง); RY1 ต้องระบุ BEV
  weightFrom     Decimal             @db.Decimal(10, 2) // น้ำหนัก (กก.) เริ่มต้นของขั้นนี้ (รวม)
  weightTo       Decimal?            @db.Decimal(10, 2) // น้ำหนัก (กก.) สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด
  amount         Decimal?            @db.Decimal(10, 2) // ภาษี/ปี (บาท) - ยังไม่มีข้อมูล รอผู้ใช้ให้ตาราง EV_WEIGHT_TAX_TABLE / RY2_WEIGHT_TAX_TABLE / RY3_WEIGHT_TAX_TABLE
  sortOrder      Int                 @default(0)
  status         GovTaxRuleStatus    @default(DRAFT)
  active         Boolean             @default(false)
  legalReference String?

  @@unique([vehicleFamily, fuelGroup, weightFrom])
}

model GovernmentTaxEvIncentive {
  id              String              @id @default(cuid())
  vehicleFamily   GovTaxVehicleFamily // เช่น RY1 (รถยนต์ไฟฟ้า)
  label           String // ชื่อมาตรการ เช่น "มาตรการลดภาษีรถ EV ปีงบประมาณ 2569"
  effectiveFrom   DateTime // เทียบกับ Vehicle.firstRegistrationDate
  effectiveTo     DateTime?
  discountPercent Decimal?            @db.Decimal(5, 2) // % ที่ลดจากภาษีที่คำนวณได้จาก GovernmentTaxWeightBracket - ยังไม่มีข้อมูล ห้าม hard-code
  note            String?
  status          GovTaxRuleStatus    @default(DRAFT)
  active          Boolean             @default(false)
  legalReference  String?
}

model GovernmentTaxMotorcycleFlat {
  id             String           @id @default(cuid())
  fuelGroup      GovTaxFuelGroup  @unique // ICE = 100 บาท/ปีทุก cc (ตามกฎ); BEV = กฎรถจักรยานยนต์ไฟฟ้าแยกต่างหาก ยังไม่มีข้อมูล
  amount         Decimal?         @db.Decimal(10, 2)
  note           String?
  status         GovTaxRuleStatus @default(DRAFT)
  active         Boolean          @default(false)
  legalReference String?
}

// --- เจ้าของรถ (VehicleOwner) และ snapshot ผลคำนวณภาษี (TaxCalculation) ------------------
// VehicleOwner is deliberately separate from Customer: the customer submitting the
// paperwork (Vehicle.customerId) is not necessarily the vehicle's registered owner - never
// infer one from the other. juristicMultiplier's hire-purchase exception depends on
// isHirePurchaseBusiness/hirerType on THIS record, matching the vehicle at hand, not a
// permanent trait of the customer.
enum OwnerType {
  INDIVIDUAL // บุคคลธรรมดา
  JURISTIC // นิติบุคคล
}

model VehicleOwner {
  id                     String     @id @default(cuid())
  // ชื่อผู้ถือกรรมสิทธิ์ (เจ้าของตามทะเบียน) - ติ๊กไฟแนนซ์แล้ว = ชื่อไฟแนนซ์อัตโนมัติ ไม่ติ๊ก = ชื่อที่ผู้ใช้กรอกในหน้าเพิ่มข้อมูลรถ
  name                   String?
  // ชื่อผู้ครอบครอง (ผู้เช่าซื้อ) - กรอกเฉพาะเมื่อติ๊กไฟแนนซ์ (ผู้ใช้เพิ่ม 2026-09-22) ไม่มีไฟแนนซ์ = null
  hirerName              String?
  ownerType              OwnerType
  isHirePurchaseBusiness Boolean    @default(false) // ประกอบธุรกิจเช่าซื้อหรือไม่ - ใช้เฉพาะเมื่อ ownerType = JURISTIC
  hirerType              OwnerType? // ผู้เช่าซื้อรถคันนี้ - null เมื่อไม่ใช่กรณีเช่าซื้อ หรือบริษัทเช่าซื้อใช้รถเอง
  // ไฟแนนซ์ (หน้าเพิ่มข้อมูลรถจดใหม่ติ๊ก "ไฟแนนซ์" แล้วเลือกบริษัท) - ไฟแนนซ์เป็นเจ้าของรถตามทะเบียน (นิติบุคคลที่ประกอบ
  // ธุรกิจเช่าซื้อ) ส่วนบุคคลธรรมดา/นิติบุคคลที่ผู้ใช้เลือกในหน้านั้นเก็บเป็น hirerType (ผู้เช่าซื้อ) - ดู VehiclesService.ownerDataFor
  financeCompanyId       String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  financeCompany FinanceCompany? @relation(fields: [financeCompanyId], references: [id])
  vehicles       Vehicle[]

  @@index([financeCompanyId])
}

// บริษัทไฟแนนซ์ - รายชื่อผู้ใช้กำหนดเอง เพิ่มได้จากหน้าเพิ่มข้อมูลรถจดใหม่เหมือนยี่ห้อ (ดู backend/src/finance-companies)
model FinanceCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(1000)
  createdAt DateTime @default(now())

  owners VehicleOwner[]
}

// Immutable audit snapshot: การคำนวณใหม่สร้างแถวใหม่เสมอ ไม่ update ของเดิม (เหมือน VehicleEditLog)
model TaxCalculation {
  id                       String               @id @default(cuid())
  vehicleId                String
  status                   String // CALCULATED | MISSING_INPUT | MISSING_VERIFIED_RULE
  vehicleFamily            GovTaxVehicleFamily?
  fuelGroup                GovTaxFuelGroup?
  baseAmount               Decimal?             @db.Decimal(12, 2)
  incentiveDiscountPercent Decimal?             @db.Decimal(5, 2)
  juristicMultiplier       Int                  @default(1)
  finalAmount              Decimal?             @db.Decimal(12, 2) // null = ยังคำนวณภาษีไม่ได้ (ห้ามแสดง 0 บาทแทน)
  reason                   String? // เหตุผลที่คำนวณไม่ได้ (ถ้ามี)
  inputSnapshot            Json
  breakdown                Json
  createdAt                DateTime             @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// --- ยื่นเอกสารจดทะเบียนรถใหม่ (Step 4) - snapshot ค่าธรรมเนียม Bill/No bill ------------
// Audit snapshot เหมือน TaxCalculation ข้างบน: การยื่นเอกสารแต่ละครั้งสร้างแถวใหม่เสมอ ไม่ update ของเดิม
// billItems/noBillItems เก็บ breakdown ที่คำนวณจริง ณ ตอนยื่น (จาก FeeCarBillParam/FeeCarNoBillParam/
// FeeMotorcycleBillParam/FeeMotorcycleNoBillParam) กันไม่ให้ประวัติเปลี่ยนไปตามอัตราที่อาจแก้ในอนาคต
// taxAmount คัดลอกมาจาก TaxCalculation.finalAmount ล่าสุด ณ ตอนยื่น (อาจ null ถ้ายังคำนวณภาษีไม่ได้) เพื่อให้
// หน้า records-by-date โชว์ยอดรวมได้โดยไม่ต้อง join ย้อนกลับไปหา TaxCalculation
//
// status เป็นข้อยกเว้นเดียวที่ mutable (ทุกฟิลด์อื่นเป็น snapshot คงที่ตลอดไป): PENDING (ค่าเริ่มต้น - ยื่น
// แล้ว รอใบเสร็จจากกรมขนส่ง) -> RECEIPT_RECEIVED (ได้รับใบเสร็จแล้ว) หรือ FAILED (ยื่นไม่สำเร็จ ต้องแก้ไข/
// ยื่นใหม่) เปลี่ยนได้ครั้งเดียวจาก PENDING เท่านั้น (ดู DocumentSubmissionService.updateStatus) รถคันหนึ่ง
// จะยื่นเอกสารซ้ำไม่ได้ตราบใดที่ยังมี DocumentSubmission ล่าสุดค้างสถานะ PENDING อยู่ (บังคับใน
// DocumentSubmissionService.submit() กันยื่นซ้ำโดยไม่ได้ตั้งใจระหว่างรอกรมขนส่งดำเนินการ)
model DocumentSubmission {
  id                  String    @id @default(cuid())
  vehicleId           String
  submitDate          DateTime // วันที่ยื่นเอกสาร (ล็อกจากวันที่ตั้งไว้ตอนเริ่ม session ฝั่ง UI)
  status              String    @default("PENDING") // PENDING | RECEIPT_RECEIVED | FAILED - มี PENDING/RECEIPT_RECEIVED = ยื่นซ้ำไม่ได้ (RECEIPT_RECEIVED = จดทะเบียนแล้ว ตลอดไป)
  receiptReceivedDate DateTime? // วันที่ได้รับใบเสร็จ = วันที่ของกลับมาถึงออฟฟิศ (ตั้งตอน status -> RECEIPT_RECEIVED) ใช้ดูว่ารอนานเท่าไร
  receiptDate         DateTime? // วันที่ที่พิมพ์บนใบเสร็จ (ผู้ใช้ 2026-09-25: วันที่ทางการ) - AI อ่านให้ พนักงานแก้ได้ ไม่มีใช้วันที่ยื่น (NULL = รายการก่อนมีช่องนี้)
  receiptAmount       Decimal?  @db.Decimal(12, 2) // ยอดที่เห็นบนใบเสร็จจริง (พนักงานกรอก) - เทียบกับ Bill = billFeeTotal + taxAmount
  receiptNo           String? // เลขที่ใบเสร็จ ("เลขที่" มุมขวาบน เช่น 69/0035358) - AI กรอกให้ พนักงานแก้ได้ ใช้เรียงตอนไปห้องรับป้าย
  failRemark          String? // เหตุผลที่ยื่นไม่สำเร็จ - บังคับกรอกตอน status -> FAILED แล้วรถกลับไปทำ Step 4 ใหม่ได้
  receiptCarriedAt    DateTime? // ตรวจใบยื่นแล้วยังไม่ได้ใบเสร็จและยังไม่รู้สาเหตุ -> ย้ายไป "ค้างจากใบก่อน" (ยัง PENDING)
  // NONE | NORMAL | AUCTION | SWAP_NORMAL | SWAP_AUCTION - SWAP_* = "มีคนทำสลับเลขมาให้" (ผู้ใช้ 2026-09-27) แผ่นป้าย
  // ขาวดำ / ประมูล ต้องมีหมวด+เลข ไม่มีค่าขอใช้เลข ไม่นับเป็นคำขอเพิ่ม (ค่าคำขอ/อากรตามปกติ) คิดค่าแผ่นป้ายตามปกติ
  plateNumberOption   String
  includePlateFee     Boolean   @default(true)
  newPlateOption      String? // NONE | BLACKWHITE | AUCTION - รถยนต์เท่านั้น, null สำหรับมอเตอร์ไซค์
  relocateAddon       Boolean   @default(false) // แจ้งย้ายออกต่างจังหวัดพร้อมกัน - รถยนต์เท่านั้น
  stopUseRelocateOut  Boolean   @default(false) // จดใหม่ หยุดใช้ย้ายออก (ลงขัน 250 บาท) - มอเตอร์ไซค์เท่านั้น
  urgent              Boolean   @default(false)
  billItems           Json // snapshot [{label, amount}] ไม่รวมภาษี
  noBillItems         Json
  billFeeTotal        Decimal   @db.Decimal(12, 2)
  noBillTotal         Decimal   @db.Decimal(12, 2)
  taxAmount           Decimal?  @db.Decimal(12, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vehicle  Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  receipts ReceiptImage[]

  @@index([vehicleId])
  @@index([submitDate])
}

// --- รูปใบเสร็จ (หน้ารับใบเสร็จ) ---------------------------------------------------
// เก็บรูปใบเสร็จไว้อ้างอิงตอนวางบิลลูกค้า ตัวไฟล์อยู่ใน storage (ตอนนี้ดิสก์ในเครื่อง ต่อไป Cloudflare R2)
// ตารางนี้เก็บแค่ key ของไฟล์ + ผลที่อ่านได้. submissionId null = อัปโหลดแบบหลายใบแล้วยังไม่ได้จับคู่กับรถ.
// รายการยื่นหนึ่งรายการมีได้หลายรูป (ถ่ายใหม่ / ใบเสร็จหลายแผ่น).
model ReceiptImage {
  id               String   @id @default(cuid())
  submissionId     String?
  storageKey       String   @unique
  mimeType         String
  sizeBytes        Int
  originalName     String?
  contentHash      String?  @unique // SHA-256 ของไฟล์ - กันอัปโหลดรูปเดิมซ้ำ (NULL = รูปก่อน 2026-09-24)
  extractionSource String   @default("NONE") // NONE = ยังไม่ได้ใช้ AI อ่าน | model id ของ AI ที่อ่าน
  extraction       Json? // ผลที่ AI อ่านได้ - รูปแบบจะกำหนดหลังเห็นใบเสร็จจริง
  readPending      Boolean  @default(false) // true = อัปโหลดหลายใบแล้วรอ AI อ่านเบื้องหลัง (ReceiptsService.enqueueRead)
  createdAt        DateTime @default(now())

  // ใบเสร็จของงานสลับเลข (รับเอกสารกลับ) - รูปหนึ่งเป็นของรายการยื่นเอกสารรถใหม่ หรือของงานสลับเลข อย่างใดอย่างหนึ่ง
  plateSwapId String?
  // หรือของงานยกเลิกการใช้รถ (ผู้ใช้ 2026-10-02) - ทั้งสองช่องว่างพร้อมกัน = ใบเสร็จรถจดใหม่ที่ยังไม่จับคู่
  vehicleUseCancellationId String?
  // หรือของงานคัดแผ่นป้ายทะเบียน (ผู้ใช้ 2026-10-02)
  plateCopyId String?

  submission             DocumentSubmission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  plateSwap              PlateSwap?              @relation(fields: [plateSwapId], references: [id], onDelete: Cascade)
  vehicleUseCancellation VehicleUseCancellation? @relation(fields: [vehicleUseCancellationId], references: [id], onDelete: Cascade)
  plateCopy PlateCopy? @relation(fields: [plateCopyId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([plateSwapId])
  @@index([vehicleUseCancellationId])
  @@index([plateCopyId])
}

// --- การสลับเลข (Plate swap) ------------------------------------------------------
// ผู้ใช้ 2026-09-22: เริ่มจากรถยนต์ แบบ "รถเก่า <-> รถใหม่" ก่อน (รถจักรยานยนต์ และ "รถเก่า <-> รถเก่า" รอเงื่อนไขจากผู้ใช้)
// หนึ่งแถว = งานสลับเลขของรถเก่า 1 คัน (รถเก่าไม่อยู่ในฐานข้อมูลรถจดใหม่ จึงกรอกข้อมูลเอง) ลิงก์กับรถใหม่ใน
// ฐานข้อมูลรถจดใหม่ได้ด้วยเลขตัวถัง (newVehicleId) ค่าใช้จ่ายคิดตอนบันทึก (ดู backend/src/plate-swap/plate-swap-fee.ts)
// แล้วเก็บ snapshot ไว้ใน billItems/noBillItems. ขั้นตอน: ยื่น (submitDate) -> รับเอกสารกลับ (returnedDate + รูปใบเสร็จ)
enum PlateSwapKind {
  OLD_NEW // รถเก่า <-> รถใหม่ (รถใหม่จากฐานข้อมูลรถจดใหม่)
  OLD_OLD // รถเก่า <-> รถเก่า (ยังไม่เปิดใช้ - รอเงื่อนไข)
}

// ที่มาของเลขทะเบียนใหม่ของรถเก่า - กำหนดรายการค่าธรรมเนียม (Bill) ที่ต่างกัน
enum PlateSwapNumberSource {
  NEW_UNUSED // ขอใช้เลขทะเบียนที่ไม่เคยออกให้รถคันอื่น 500 บาท
  AUCTION_RESERVED // เลขประมูลหรือชุดสงวน - ขอใช้เลขทะเบียนสงวน 1,500 บาท
}

model PlateSwap {
  id           String        @id @default(cuid())
  kind         PlateSwapKind @default(OLD_NEW)
  vehicleClass String        @default("CAR") // CAR | MOTO - ตอนนี้รับเฉพาะ CAR (อัตราจักรยานยนต์ยังไม่มี)

  // เจ้าของงาน = ลูกค้าที่ส่งงานนี้มาให้เรา (ผู้ใช้ 2026-09-28: "เวลาจะส่งงานหรือวางบิลจะได้วางถูก")
  // คนละคนกับ oldOwnerName ซึ่งเป็นเจ้าของรถเก่าตามทะเบียน - ห้ามอนุมานจากกัน (กฎเดียวกับ Vehicle.customerId กับ Vehicle.ownerId)
  // ยอมให้ว่างในฐานข้อมูลเพราะงานที่บันทึกไว้ก่อน 2026-09-28 ยังไม่มีลูกค้า (ห้ามเดาย้อนหลังให้) แต่งานที่บันทึกใหม่
  // บังคับกรอกที่ชั้น service - ดู PlateSwapService.resolveCustomerId
  customerId String?

  // เคส "รถเก่า กับ รถเก่า" (ผู้ใช้ 2026-09-28): กรอก 2 คันในหน้าเดียว แต่ระบบเก็บ "แยกเป็น 2 งาน" คันละแถว
  // ที่อ้างถึงกันด้วย pairId เดียวกัน - แต่ละงานเดินขั้นรับใบเสร็จ/ป้าย/เล่มของตัวเองแยกกัน และคิดค่าใช้จ่ายคนละชุด
  // ทะเบียนของคู่ไขว้กัน: newPlate ของงานนี้ = oldPlate ของงานคู่ (ต่างจาก OLD_NEW ที่ยังไม่รู้เลขใหม่ตอนยื่น)
  // NULL = งาน OLD_NEW ซึ่งไม่มีคู่
  pairId String?

  // รถเก่า (กรอกเอง)
  oldOwnerName     String // ชื่อเจ้าของรถ
  // ผู้ใช้ 2026-09-23: แยกเลขเครื่องกับเลขตัวถังเป็นคนละช่อง และบังคับกรอกทั้งคู่ (ต่างจาก Vehicle ของรถจดใหม่ที่เลขเครื่องไม่บังคับ)
  oldEngine        String // เลขเครื่อง
  oldChassis       String // เลขตัวถัง
  oldBrand         String // ยี่ห้อ
  // ทะเบียนแยก 2 ช่องเหมือน Vehicle ของรถจดใหม่ (ผู้ใช้ 2026-09-23): หมวดทะเบียน เช่น "4กข" + เลขทะเบียน เช่น "4444"
  oldPlateCategory String // หมวดทะเบียนเก่า
  oldPlateNumber   String // เลขทะเบียนเก่า
  // ทะเบียนใหม่ที่รถเก่าจะได้รับ - ตอนยื่นอาจยังไม่รู้ กรอกทีหลังได้ และบังคับตอนยืนยันรับเอกสารกลับ
  newPlateCategory String?
  newPlateNumber   String?

  // รถใหม่ในฐานข้อมูลรถจดใหม่ที่รับเลขจากรถเก่า (ลิงก์ด้วยเลขตัวถัง) - หน้ายื่นเอกสารของรถคันนั้นจะเห็นเลขสลับ
  // และกดใช้เลขนี้เป็นเลขที่ขอได้ (ผู้ใช้ 2026-09-23)
  newVehicleId String?

  submitDate DateTime // วันที่ยื่น

  // ค่าใช้จ่าย - ตัวเลือกที่ผู้ใช้ติ๊ก + snapshot รายการ ณ ตอนบันทึก
  numberSource    PlateSwapNumberSource
  buyNormalPlate  Boolean               @default(false) // ค่าแผ่นป้ายทะเบียนรถยนต์ออกใหม่ รับปกติ / ขาว-ดำปกติ 200 บาท
  buyAuctionPlate Boolean               @default(false) // ค่าแผ่นป้ายประมูล 1,200 บาท (เฉพาะ AUCTION_RESERVED)
  // งานด่วน - มีเฉพาะรถจักรยานยนต์ (ผู้ใช้ 2026-09-28: ด่วนเพิ่ม 50 บาท ใน No Bill ชื่อรายการ "ลงขันด่วนเพิ่ม"
  // ตามงานจดรถใหม่) ฝั่งรถยนต์ยังไม่มีอัตรางานด่วนของการสลับเลข จึงเป็น false เสมอ
  urgent          Boolean               @default(false)
  billItems       Json // [{label, amount}]
  noBillItems     Json // [{label, amount}] - ลงขัน 200 บาท
  billTotal       Decimal               @db.Decimal(12, 2)
  noBillTotal     Decimal               @db.Decimal(12, 2)

  // รับเอกสารกลับ - วันที่ไม่ว่าง = รับกลับแล้ว (แนบรูปใบเสร็จผ่าน ReceiptImage.plateSwapId)
  returnedDate DateTime?

  // ส่งงานคืนลูกค้า (ผู้ใช้ 2026-09-28: "สลับเลขลืม Delivery") - ชุดเดียวกับ Vehicle เพื่อให้กฎ
  // "ส่งเล่มก่อน ป้ายตามทีหลัง" ทำงานเหมือนกัน: deliveredDate = ส่งเล่มแล้ว / plateDeliveredDate ว่างทั้งที่
  // deliveredDate ไม่ว่าง = ป้ายค้างส่ง เข้าคิว Delivery อีกครั้งเป็นงานส่งป้ายอย่างเดียว
  // เข้าคิวได้เมื่อได้ใบเสร็จ (returnedDate) + รับเล่มแล้ว (bookReceivedDate) - ใบเสร็จไม่ส่งไปกับงาน (ไปกับใบวางบิล)
  deliveredDate      DateTime?
  deliveryRecipient  String?
  deliveryNote       String?
  plateDeliveredDate DateTime?

  // แยกขั้นรับเอกสารกลับเป็น 3 ขั้น เหมือนฝั่งรถจดใหม่ (ผู้ใช้ 2026-09-28) - "งานเสร็จ" ยังผูกกับ returnedDate อย่างเดียวเหมือนเดิม
  // ไม่ผูกกับ 3 ช่องนี้เลย: รับป้าย/รับเล่มเป็นแค่ขั้นบันทึกข้อมูลเพิ่มที่ไม่มีกฎ gating ใดๆ (ไม่ต้องรอ returnedDate ก่อนก็ได้)
  // รับใบเสร็จ: อ่าน OCR จริงจากรูปที่แนบ (เหมือน Step 5) เติมให้เฉพาะตอนช่องยังว่างทั้ง 3 ช่อง แก้เองทีหลังได้เสมอ
  receiptNo     String? // เลขที่ใบเสร็จ
  receiptDate   DateTime? // วันที่พิมพ์บนใบเสร็จ
  receiptAmount Decimal?  @db.Decimal(12, 2) // ยอดเงินตามใบเสร็จ

  // รับป้าย/รับเล่ม (ไม่ใช้ AI เหมือน Step 6/7 ปัจจุบัน) - เฉพาะฝั่งรถเก่าของงานนี้เท่านั้น ไม่แตะรถใหม่ที่ลิงก์ไว้
  // (รถใหม่มีรับป้าย/รับเล่มของตัวเองอยู่แล้วผ่านหน้างานจดทะเบียนรถใหม่ปกติ) ใช้ตาราง PlatePhoto/BookPhoto เดิมร่วมกับ Vehicle
  plateReceivedDate DateTime?
  platePhotoId      String?
  bookReceivedDate  DateTime?
  bookPhotoId       String?

  // ยกเลิกงาน (soft cancel - ผู้ใช้ 2026-09-27 ห้ามลบแถว): ADMIN/STAFF_CAR ต้องระบุเหตุผล บันทึกประวัติลง AuditLog
  // cancelledAt ไม่ว่าง = ยกเลิกแล้ว ไม่แสดงในรายการ ยอดรวม และภาพรวม และไม่ล็อกการยื่นเอกสารของรถใหม่ที่ผูกไว้
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?      @relation(fields: [customerId], references: [id])
  newVehicle  Vehicle?       @relation(fields: [newVehicleId], references: [id], onDelete: SetNull)
  cancelledBy User?          @relation("PlateSwapCancels", fields: [cancelledById], references: [id], onDelete: SetNull)
  platePhoto  PlatePhoto?    @relation(fields: [platePhotoId], references: [id], onDelete: SetNull)
  bookPhoto   BookPhoto?     @relation(fields: [bookPhotoId], references: [id], onDelete: SetNull)
  receipts    ReceiptImage[]
  // รายการในใบส่งงาน - ใบเดียวกับรถจดใหม่ได้ (ผู้ใช้ 2026-09-28)
  deliverySlipItems DeliverySlipItem[]
  // บรรทัดในบิลที่เก็บค่าใบเสร็จกรมฯ ของรถเก่างานนี้ (ผู้ใช้ 2026-09-28) - งานหนึ่งขึ้นบิลได้ครั้งเดียว
  invoiceLines      InvoiceLine[]

  @@index([customerId])
  @@index([pairId])
  @@index([newVehicleId])
  @@index([submitDate])
  @@index([returnedDate])
  @@index([plateReceivedDate])
  @@index([bookReceivedDate])
}

// --- ยกเลิกการใช้รถ (Vehicle use cancellation) ---------------------------------------
// ผู้ใช้ 2026-10-02: งานในหมวด "อื่นๆ" - กรอกข้อมูลรถเหมือนการสลับเลข (ไม่มีทะเบียนใหม่) ทั้งรถยนต์และมอเตอร์ไซค์
// รถไม่อยู่ในฐานข้อมูลรถจดใหม่ จึงกรอกเอง หนึ่งแถว = ยกเลิกการใช้รถ 1 คัน
// ค่าใช้จ่ายตายตัว Bill 25 / No Bill 100 / ค่าอากร 10 แยกต่างหาก บาทต่อคัน (ผู้ใช้ 2026-10-02) ขั้นตอน: ยื่น (submitDate) -> รับใบเสร็จกลับ
// (returnedDate + รูปใบเสร็จอย่างน้อย 1 รูป) แบบเดียวกับการสลับเลข - ยังไม่มีรับป้าย/เล่ม/ส่งงาน/วางบิล (ผู้ใช้ไม่ได้สั่ง)
// หมายเหตุชื่อ: cancelledAt = "งานนี้ถูกยกเลิกในระบบ" (soft cancel เหมือน PlateSwap) ไม่ใช่การยกเลิกการใช้รถ
model VehicleUseCancellation {
  id           String @id @default(cuid())
  vehicleClass String @default("CAR") // CAR | MOTO

  // เจ้าของงาน = ลูกค้าที่ส่งงานมา (คนละคนกับ ownerName ซึ่งเป็นเจ้าของรถตามทะเบียน) - บังคับกรอกที่ชั้น service
  customerId String?

  ownerName     String // ชื่อเจ้าของรถ
  engine        String // เลขเครื่อง
  chassis       String // เลขตัวถัง
  brand         String // ยี่ห้อ (ชื่อตามตาราง Brand)
  plateCategory String // หมวดทะเบียน
  plateNumber   String // เลขทะเบียน

  submitDate DateTime // วันที่ยื่น

  billTotal   Decimal @default(0) @db.Decimal(12, 2) // ค่าใช้จ่าย Bill - ตายตัว 25 บาท snapshot ตอนยื่น
  noBillTotal Decimal @default(0) @db.Decimal(12, 2) // ค่าใช้จ่าย No Bill - ตายตัว 100 บาท (ไม่รวมค่าอากร, snapshot ตอนยื่น)
  dutyAmount  Decimal @default(0) @db.Decimal(12, 2) // ค่าอากร 10 บาท แยกต่างหาก ไม่รวมใน noBillTotal และไม่นับในยอดรวม (snapshot ตอนยื่น)

  // รับใบเสร็จกลับ - วันที่ไม่ว่าง = รับกลับแล้ว (แนบรูปผ่าน ReceiptImage.vehicleUseCancellationId)
  returnedDate  DateTime?
  receiptNo     String?
  receiptDate   DateTime?
  receiptAmount Decimal?  @db.Decimal(12, 2)

  // ยกเลิกงาน (soft cancel) - cancelledAt ไม่ว่าง = ไม่แสดงในรายการและยอดรวม
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?      @relation(fields: [customerId], references: [id])
  cancelledBy User?          @relation("VehicleUseCancellationCancels", fields: [cancelledById], references: [id], onDelete: SetNull)
  receipts    ReceiptImage[]

  @@index([customerId])
  @@index([submitDate])
  @@index([returnedDate])
}

// --- คัดแผ่นป้ายทะเบียน (Plate copy) ---------------------------------------------------
// ผู้ใช้ 2026-10-02: งานในหมวด "อื่นๆ" - ทำเหมือนยกเลิกการใช้รถ (กรอกข้อมูลรถเหมือนสลับเลข ไม่มีทะเบียนใหม่) แต่เป็นรถยนต์เท่านั้น
// และมีขั้นรับป้ายด้วย: ยื่น -> รับใบเสร็จกลับ -> รับป้าย (แนบรูปป้ายที่ได้รับ + วันที่รับ) ปกติป้ายออกภายใน 15 (วัน)
// ค่าใช้จ่ายตายตัว Bill 205 / No Bill 100 / ค่าอากร 10 (แยกต่างหาก ไม่รวมใน No Bill และยอดรวม) snapshot ตอนยื่น
// รูปป้ายใช้ตาราง PlatePhoto เดียวกับรถจดใหม่/สลับเลข (hash กันอัปโหลดซ้ำ) / ใบเสร็จใช้ ReceiptImage.plateCopyId
// cancelledAt = "งานนี้ถูกยกเลิกในระบบ" (soft cancel เหมือน PlateSwap)
model PlateCopy {
  id           String @id @default(cuid())
  vehicleClass String @default("CAR") // ตอนนี้รับเฉพาะ CAR (ผู้ใช้ 2026-10-02: รถยนต์ก่อน)

  // เจ้าของงาน = ลูกค้าที่ส่งงานมา (คนละคนกับ ownerName) - บังคับกรอกที่ชั้น service
  customerId String?

  ownerName     String // ชื่อเจ้าของรถ
  engine        String // เลขเครื่อง
  chassis       String // เลขตัวถัง
  brand         String // ยี่ห้อ (ชื่อตามตาราง Brand)
  plateCategory String // หมวดทะเบียน
  plateNumber   String // เลขทะเบียน

  submitDate DateTime // วันที่ยื่น

  billTotal   Decimal @default(0) @db.Decimal(12, 2) // Bill - ตายตัว 205 บาท (snapshot ตอนยื่น)
  noBillTotal Decimal @default(0) @db.Decimal(12, 2) // No Bill - ตายตัว 100 บาท (ไม่รวมค่าอากร)
  dutyAmount  Decimal @default(0) @db.Decimal(12, 2) // ค่าอากร 10 บาท แยกต่างหาก ไม่รวมใน noBillTotal และไม่นับในยอดรวม

  // รับใบเสร็จกลับ - วันที่ไม่ว่าง = รับกลับแล้ว (แนบรูปผ่าน ReceiptImage.plateCopyId)
  returnedDate  DateTime?
  receiptNo     String?
  receiptDate   DateTime?
  receiptAmount Decimal?  @db.Decimal(12, 2)

  // รับป้าย - แนบรูปป้ายที่ได้รับ + วันที่รับ (ตั้งพร้อมกัน) ไม่ผูกกับ returnedDate
  plateReceivedDate DateTime?
  platePhotoId      String?

  // ยกเลิกงาน (soft cancel) - cancelledAt ไม่ว่าง = ไม่แสดงในรายการและยอดรวม
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?      @relation(fields: [customerId], references: [id])
  cancelledBy User?          @relation("PlateCopyCancels", fields: [cancelledById], references: [id], onDelete: SetNull)
  platePhoto  PlatePhoto?    @relation(fields: [platePhotoId], references: [id], onDelete: SetNull)
  receipts    ReceiptImage[]

  @@index([customerId])
  @@index([submitDate])
  @@index([returnedDate])
  @@index([plateReceivedDate])
}

// --- งานแจ้งย้ายยามาฮ่า (Yamaha relocation notice) --------------------------------
// Standalone log - not linked to Customer/Vehicle. One row = one day's notice batch for
// one size (size splits the two UI pages รถเล็ก/รถใหญ่). count is the number of vehicles
// that day; every vehicle carries both a Bill portion and a No bill portion of the fee
// (not an either/or choice per vehicle), so billFee/noBillFee are both derived from the
// same count. Fees are snapshotted at creation time from the fixed rates in
// src/yamaha-relocation/yamaha-relocation-fee.ts, so a future rate change never rewrites
// history: รถเล็ก Bill 5 บาท/คัน, No bill 10 บาท/คัน — รถใหญ่ Bill 5 บาท/คัน, No bill 20 บาท/คัน.
// The fee split is bookkeeping only - not shown in the UI, per the user's instruction.

enum YamahaRelocationSize {
  SMALL // รถเล็ก
  LARGE // รถใหญ่
}

model YamahaRelocationEntry {
  id        String               @id @default(cuid())
  date      DateTime // วันที่แจ้งย้าย
  size      YamahaRelocationSize
  count     Int // จำนวนคันในวันนั้น
  billFee   Decimal              @db.Decimal(10, 2) // count x อัตรา Bill ณ ตอนบันทึก
  noBillFee Decimal              @db.Decimal(10, 2) // count x อัตรา No bill ณ ตอนบันทึก
  createdAt DateTime             @default(now())

  // ยกเลิกรายการ (soft cancel - ผู้ใช้ 2026-09-27 ห้ามลบแถว): ADMIN/STAFF_ENTRY ต้องระบุเหตุผล บันทึกประวัติลง AuditLog
  // cancelledAt ไม่ว่าง = ยกเลิกแล้ว ไม่แสดงในรายการ ยอดรวม และภาพรวม - ตอนยกเลิกล้าง contentHash ของไฟล์แนบ
  // (YamahaRelocationAttachment) ให้แนบไฟล์เดิมกับรายการที่ถูกต้องได้อีก
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  attachments YamahaRelocationAttachment[]
  cancelledBy User?                        @relation("YamahaRelocationCancels", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([size, date])
}

// ไฟล์แนบของรายการแจ้งย้ายยามาฮ่า (ผู้ใช้ 2026-09-22: ทุกครั้งที่กรอกจำนวนคันต่อวันต้องแนบ ใบเสร็จ 1 ไฟล์ + Report 1 ไฟล์ เสมอ)
// ตัวไฟล์อยู่ใน storage เดียวกับรูปใบเสร็จ (ดิสก์เครื่อง/R2) key ขึ้นต้น yamaha-relocation/receipts/ หรือ yamaha-relocation/reports/
// โหลดไฟล์ผ่าน GET /api/yamaha-relocation/attachments/:id/file
enum YamahaRelocationAttachmentKind {
  RECEIPT // ใบเสร็จ
  REPORT // Report
}

model YamahaRelocationAttachment {
  id           String                         @id @default(cuid())
  entryId      String
  kind         YamahaRelocationAttachmentKind
  storageKey   String                         @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  contentHash  String?                        @unique // SHA-256 ของไฟล์ - กันอัปโหลดรูปเดิมซ้ำ (NULL = รูปก่อน 2026-09-24)
  createdAt    DateTime                       @default(now())

  entry YamahaRelocationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, kind]) // แนบได้หลายไฟล์ต่อชนิด (ผู้ใช้ 2026-09-30) - เดิม unique ทำให้บันทึก 2 ไฟล์ขึ้นไปไม่ได้
}

// --- รูปป้ายทะเบียน (หน้ารับป้ายทะเบียน Step 6) ------------------------------------
// พนักงานถ่ายรูปป้ายที่ได้รับ (รูปเดียวมีได้หลายแผ่น) -> AI อ่านเลขทะเบียน -> ระบบจับคู่กับรถที่รอรับป้าย
// จากทะเบียนที่รู้แล้วใน Step 5 (Vehicle.plateCategory/plateNumber). extraction เก็บแค่ผลอ่าน ส่วนการจับคู่
// คำนวณใหม่ทุกครั้งที่เปิดดู (คิวเปลี่ยนได้). AI ไม่บันทึกเอง - พนักงานกดยืนยันแล้วจึงตั้ง Vehicle.plateReceivedDate
// พร้อม Vehicle.platePhotoId เป็นหลักฐาน. closedAt ไม่ว่าง = ยืนยัน/ปิดรูปนี้แล้ว ไม่แสดงในถาดรอยืนยัน
// ตั้งแต่ 2026-09-26 (ผู้ใช้) ไม่ใช้ AI แล้ว: แนบรูปรายคันจากคิว (POST /api/plate-photos/attach) รูปถูกปิดทันที
// extraction/readPending เหลือไว้สำหรับแถวเก่า
model PlatePhoto {
  id               String    @id @default(cuid())
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  originalName     String?
  contentHash      String?   @unique // SHA-256 ของไฟล์ - กันอัปโหลดรูปเดิมซ้ำ (NULL = รูปก่อน 2026-09-24)
  kind             String    @default("car") // car | moto - แท็บที่ถ่าย จับคู่เฉพาะรถประเภทเดียวกัน (ป้ายรถยนต์/มอเตอร์ไซค์ เลขซ้ำกันได้)
  extractionSource String    @default("NONE") // NONE = ไม่ได้ใช้ AI | model id ของ AI ที่อ่าน
  extraction       Json? // { plates: [...], usage } หรือ { error }
  readPending      Boolean   @default(false) // true = เลือกหลายรูปแล้วรอ AI อ่านเบื้องหลัง (BackgroundReads)
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  vehicles   Vehicle[]
  plateSwaps PlateSwap[] // รูปป้ายของงานสลับเลข (รถเก่า) - ตารางเดียวกับรูปป้ายรถจดใหม่ (ผู้ใช้ 2026-09-28)
  plateCopies PlateCopy[] // รูปป้ายที่ได้รับของงานคัดแผ่นป้ายทะเบียน (ผู้ใช้ 2026-10-02)

  @@index([kind, closedAt])
}

// --- รูปเล่มทะเบียน (หน้ารับเล่มทะเบียน Step 7) -------------------------------------
// โครงเดียวกับ PlatePhoto: ถ่ายรูปเล่มที่ได้รับ (รูปเดียวมีได้หลายเล่ม) -> AI อ่านเลขตัวรถ (VIN) + ทะเบียน -> ระบบจับคู่
// กับรถที่รอรับเล่ม (VIN ไม่ซ้ำ จึงไม่ต้องแยกรถยนต์/มอเตอร์ไซค์). พนักงานกดยืนยันแล้วจึงตั้ง Vehicle.bookReceivedDate
// พร้อม Vehicle.bookPhotoId เป็นหลักฐาน. closedAt ไม่ว่าง = ยืนยัน/ปิดรูปนี้แล้ว ไม่แสดงในถาดรอยืนยัน
// ตั้งแต่ 2026-09-26 (ผู้ใช้) ไม่ใช้ AI แล้ว: แนบรูปรายคันจากคิว (POST /api/book-photos/attach) รูปถูกปิดทันที
// extraction/readPending เหลือไว้สำหรับแถวเก่า
model BookPhoto {
  id               String    @id @default(cuid())
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  originalName     String?
  contentHash      String?   @unique // SHA-256 ของไฟล์ - กันอัปโหลดรูปเดิมซ้ำ (NULL = รูปก่อน 2026-09-24)
  extractionSource String    @default("NONE") // NONE = ไม่ได้ใช้ AI | model id ของ AI ที่อ่าน
  extraction       Json? // { books: [...], usage } หรือ { error }
  readPending      Boolean   @default(false) // true = เลือกหลายรูปแล้วรอ AI อ่านเบื้องหลัง (BackgroundReads)
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  vehicles   Vehicle[]
  plateSwaps PlateSwap[] // รูปเล่มของงานสลับเลข (รถเก่า) - ตารางเดียวกับรูปเล่มรถจดใหม่ (ผู้ใช้ 2026-09-28)

  @@index([closedAt])
}

// --- วางบิลในนามบริษัท (พื้นที่ทำงานบัญชี) -------------------------------------------
// ขั้นตอน: พนักงานบันทึกส่งงาน (Vehicle.deliveredDate) -> รถเข้าคิวรอวางบิล -> บัญชีเลือกรถ ตรวจค่าดำเนินการ แล้วออก Invoice
// รถหนึ่งคันอยู่ในบิลที่ยังไม่ถูกยกเลิกได้ใบเดียว (บังคับใน BillingService.createInvoice)

// ตารางค่าดำเนินการต่อลูกค้า - ใช้เสนอราคาเริ่มต้นให้รถแต่ละคันตอนออกบิล (บัญชีแก้รายคันได้เสมอ)
// จับคู่ด้วยชนิดรถ + ช่วง CC (ccMin <= cc < ccMax, ว่าง = ไม่จำกัด) แถวที่ sortOrder น้อยสุดที่เข้าเงื่อนไขชนะ
model ServiceFeeRate {
  id              String   @id @default(cuid())
  customerId      String
  label           String // ข้อความบนบิล เช่น "จดทะเบียนรถจักรยานยนต์ 150 cc - 299 cc"
  vehicleKind     String   @default("ANY") // CAR | MOTO | ANY
  ccMin           Decimal? @db.Decimal(10, 2)
  ccMax           Decimal? @db.Decimal(10, 2)
  // ราคาแยกตามรุ่น/ยี่ห้อผู้ผลิตที่ CC ทับซ้อนกันแยกไม่ออก (ผู้ใช้ 2026-09-28, MC Superbike: เลขตัวถังขึ้นต้น ML = 885,
  // JH = 2685 ทั้งคู่อยู่ในช่วง 300-799cc) - เทียบกับเลขตัวถังแบบไม่สนตัวพิมพ์ใหญ่เล็ก ว่าง = ไม่จำกัด (เหมือนเดิม)
  chassisPrefix   String?
  amount          Decimal  @db.Decimal(12, 2)
  vatInclusive    Boolean  @default(false) // true = amount เป็นราคารวม VAT แล้ว (เช่น 1,045) ระบบถอดเป็นก่อน VAT (/1.07) ให้
  // true = amount เป็นราคาเหมารวมค่าใบเสร็จกรมขนส่งแล้ว (ผู้ใช้ 2026-09-27, YMAC: จดใหม่ 650 รวมใบเสร็จ 340) - ค่าดำเนินการ = amount - ค่าใบเสร็จจริงของคันนั้น
  includesReceipt Boolean  @default(false)
  // BASE = ราคาหลักเลือกตามชนิดรถ/CC, OTHER_PROVINCE (ขอใช้ = จดจังหวัดอื่น) / URGENT (ด่วน) = ค่าเพิ่มที่บวกให้เอง (ผู้ใช้ 2026-09-28, TWE)
  kind            String   @default("BASE")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// --- ใบส่งงาน Delivery (ผู้ใช้ 2026-09-25) -------------------------------------------
// กดบันทึกส่งงาน 1 ครั้ง = 1 ใบ (ลูกค้าเดียว ผู้รับคนเดียว วันเดียว) พิมพ์ให้ผู้รับเซ็น และใช้ทำรายงานส่งงานย้อนหลัง
// แต่ละคันบอกแยกว่ารอบนี้ส่งอะไร (เล่ม / ป้าย) - ส่งป้ายตามทีหลังเป็นอีกใบที่มีแค่ป้าย
// ใบเสร็จไม่ส่งไปกับงานแล้ว (ผู้ใช้ 2026-09-26) ส่งพร้อมใบวางบิล - DeliverySlipItem.receipt ของใบใหม่เป็น false เสมอ
// ใบเดียวห้ามปนรถยนต์กับจักรยานยนต์ (ผู้ใช้ 2026-09-27 - บังคับใน DeliveryService)
// วันที่/ผู้รับบน Vehicle (deliveredDate, plateDeliveredDate ...) ยังเป็นสถานะปัจจุบันที่คิวและบัญชีใช้เหมือนเดิม
// ใบของการส่งก่อนมีตารางนี้ถูกสร้างย้อนหลังจาก Vehicle ใน migration 20260925200000_add_delivery_slips
model DeliverySlip {
  id            String    @id @default(cuid())
  slipNo        Int       @unique @default(autoincrement()) // เลขที่ใบ แสดงเป็น DL-00001
  customerId    String
  date          DateTime // วันที่ส่ง
  recipient     String // ผู้รับที่ลูกค้า
  note          String?
  createdById   String? // พนักงานที่กดบันทึก (null = สร้างย้อนหลัง / นอกคำขอ HTTP)
  createdAt     DateTime  @default(now())
  // ยกเลิกทั้งใบ (ผู้ใช้ 2026-09-26): ตั้งเมื่อทุกรายการในใบถูกยกเลิก - ใบยังอยู่ในรายงานพร้อมเหตุผล ไม่ลบ เลข DL ไม่ขาดช่วง
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  customer    Customer           @relation(fields: [customerId], references: [id])
  createdBy   User?              @relation("DeliverySlips", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("DeliverySlipCancels", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       DeliverySlipItem[]

  @@index([customerId])
  @@index([date])
}

model DeliverySlipItem {
  id     String @id @default(cuid())
  slipId String
  // แถวหนึ่งเป็นได้อย่างใดอย่างหนึ่งเท่านั้น: รถจดใหม่ (vehicleId) หรืองานสลับเลข (plateSwapId)
  // ผู้ใช้ 2026-09-28: ลูกค้าเดียวกันมารับทีเดียว เซ็นใบเดียวจบ จึงผสมสองอย่างในใบเดียวกันได้
  // vehicleId ผ่อนเป็น nullable เพราะรถเก่าของงานสลับเลขไม่ได้อยู่ในตาราง Vehicle (กรอกเอง)
  // Prisma บังคับ XOR ไม่ได้ จึงบังคับที่ชั้น service (DeliveryService.parseDeliveryItems)
  vehicleId     String?
  plateSwapId   String?
  receipt       Boolean // ส่งใบเสร็จรอบนี้ - เฉพาะใบก่อน 2026-09-26 ใบใหม่เป็น false เสมอ (ใบเสร็จไปกับใบวางบิล)
  book          Boolean // ส่งเล่มทะเบียนรอบนี้
  plate         Boolean // ส่งป้ายรอบนี้
  // snapshot ตอนส่ง - พิมพ์ใบซ้ำภายหลังได้ตรงกับที่ส่งจริง
  chassis       String
  brandName     String
  body          String?
  // car | moto - ขอบเขตสิทธิ์ทุกจุดเดิมตัดสินจาก body ซึ่งงานสลับเลขไม่มี ถ้าปล่อยว่าง vehicleKindOf จะตีเป็นรถยนต์
  // ทำให้งานสลับเลขมอเตอร์ไซค์หลุดไปอยู่ในขอบเขต STAFF_CAR (ผู้ใช้ 2026-09-28) - NULL = แถวก่อนวันนี้ ให้ดู body แทน
  vehicleKind   String?
  // ชื่อเจ้าของสำหรับแถวสลับเลข (รถจดใหม่ยังอ่านสดจาก VehicleOwner เหมือนเดิม ไม่เปลี่ยนพฤติกรรมที่ใช้อยู่)
  ownerName     String?
  plateText     String // "8ขง 363" หรือ "" ถ้ายังไม่มีทะเบียน
  receiptNo     String?
  // ยกเลิกรายคัน (ผู้ใช้ 2026-09-26): คีย์ผิดคัน -> รถกลับเข้าคิว Delivery ส่วนรายการนี้เก็บไว้พร้อมเหตุผล
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  slip        DeliverySlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  plateSwap   PlateSwap?   @relation(fields: [plateSwapId], references: [id])
  cancelledBy User?        @relation("DeliverySlipItemCancels", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([slipId])
  @@index([vehicleId])
  @@index([plateSwapId])
}

// ใบวางบิล/ใบแจ้งหนี้ (IV) - ยอดทุกช่องเป็น snapshot ณ วันออกบิล ไม่คำนวณใหม่ตามอัตราที่แก้ทีหลัง
// invoiceNo พิมพ์เอง (ช่วงแรกล้อเลขกับ Google Sheet "Invoice Tradeinter") ห้ามซ้ำ
// status: ISSUED (วางบิลแล้ว รอรับเงิน) -> PAID (รับเงินแล้ว) | VOID (ยกเลิก - รถกลับเข้าคิวรอวางบิล)
// ผู้ใช้ 2026-09-27: บิล ISSUED แก้ในใบเดิมได้ (เลขเดิม) และ ADMIN/ACCOUNTANT ย้อน PAID -> ISSUED ได้ ทั้งคู่ต้องระบุเหตุผล
// และบันทึกประวัติลง AuditLog (entity 'Invoice') - customerSnapshot ไม่เปลี่ยนตามการแก้ข้อมูลลูกค้าทีหลัง
model Invoice {
  id               String    @id @default(cuid())
  invoiceNo        String    @unique
  issueDate        DateTime
  customerId       String
  customerSnapshot Json // { name, branch, address, taxId } ตามที่พิมพ์บนบิล
  jobLabel         String // เช่น "จดทะเบียนรถยนต์" - ใช้ประกอบชื่อรายการบนหน้าบิล
  extras           Json // [{ label, amount }] ค่าใช้จ่ายอื่นๆ - นับเป็นค่าดำเนินการ (คิด VAT + หัก ณ ที่จ่าย)
  vatRate          Decimal   @db.Decimal(5, 2) // 7 หรือ 0
  whtRate          Decimal   @db.Decimal(5, 2)
  feeTotal         Decimal   @db.Decimal(12, 2) // รวมค่าใบเสร็จกรมขนส่ง (เงินทดรองจ่าย ไม่คิด VAT)
  serviceTotal     Decimal   @db.Decimal(12, 2) // รวมค่าดำเนินการ + extras (ก่อน VAT)
  vatAmount        Decimal   @db.Decimal(12, 2)
  whtAmount        Decimal   @db.Decimal(12, 2)
  netTotal         Decimal   @db.Decimal(12, 2) // fee + service + goods + vat - wht = "จำนวนเงินทั้งสิ้น" บนบิล
  // ขายสินค้า (ผู้ใช้ 2026-09-29, เช่น ขายรถออกจากบริษัท) ก่อน VAT - คิด VAT แต่ไม่เป็นฐานหัก ณ ที่จ่าย
  goodsTotal       Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("ISSUED")
  paidDate         DateTime?
  taxInvoiceNo     String? // เลขที่ใบกำกับภาษี/ใบเสร็จรับเงิน (TV) ที่ออกตอนรับเงิน
  account          String    @default("COMPANY") // COMPANY | PERSONAL - บัญชีของลูกค้า ณ วันส่งงานของรถในบิล (บัญชีบุคคล = ไม่มี VAT, เลขบิลรันแยก)
  voidReason       String?
  // วันครบกำหนดชำระ = issueDate + เครดิตเทอมของลูกค้า ณ วันออกบิล (ผู้ใช้ 2026-09-28) - null = ลูกค้าไม่ได้ตั้งเครดิตเทอม / บิลก่อนมีคอลัมน์นี้
  dueDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // บิลที่ออกจากใบเสนอราคา (ผู้ใช้ 2026-10-01) - เลข QT / PO เก็บเป็น snapshot พิมพ์บนบิล · ใบเสนอราคา 1 ใบมีบิลที่ยังใช้อยู่ได้ใบเดียว
  // (partial unique index Invoice_quotation_active_key: quotationId WHERE status <> 'VOID')
  quotationId      String?
  quotationNo      String?
  poNumber         String?

  customer    Customer      @relation(fields: [customerId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  lines       InvoiceLine[]
  items       InvoiceItem[]
  taxInvoices TaxInvoice[]

  @@index([customerId])
  @@index([status])
}

// เลขใบกำกับภาษีรายปี (ผู้ใช้ 2026-09-28): TV{ปี ค.ศ.}-{3 หลัก} เช่น TV2026-001 นับใหม่ทุกปี
// lastNumber = เลขล่าสุดที่ใช้ไปแล้ว - ADMIN ตั้งเลขเริ่มให้ต่อจาก Google Sheet ได้ก่อนออกใบแรกของปีนั้นในระบบ
// ไม่มีแถวของปีใดเลย = ยังไม่เปิดใช้ใบกำกับในระบบ (บันทึกรับเงินแบบเดิม พิมพ์เลข TV เอง)
model TaxInvoiceSeries {
  year       Int      @id
  lastNumber Int
  updatedAt  DateTime @updatedAt
}

// ใบกำกับภาษี/ใบเสร็จรับเงิน (TV) ออกตอนรับเงิน เฉพาะบิลบัญชีบริษัทที่มี VAT (ผู้ใช้ 2026-09-28) - บิล 1 ใบมีใบที่ใช้อยู่ได้ 1 ใบ
// (unique index บางส่วน TaxInvoice_invoice_active_key ใน migration) · ยอดทุกช่องเป็น snapshot ออกแล้วแก้ไม่ได้
// ผิด = ยกเลิก (status CANCELLED + เหตุผล เลขเดิมไม่ใช้ซ้ำ บิลกลับเป็นรอรับเงิน) แล้วออกใบใหม่ที่อ้าง replacesId
// ลูกค้าทำต้นฉบับหาย = "ใบแทน" (replacementIssuedAt/Reason) เลขเดิม ไม่ใช่ใบใหม่
model TaxInvoice {
  id                    String    @id @default(cuid())
  taxInvoiceNo          String    @unique
  year                  Int
  number                Int
  invoiceId             String
  customerId            String
  issueDate             DateTime // = วันที่รับเงิน
  customerSnapshot      Json // { name, branch, address, taxId } ข้อมูลลูกค้าปัจจุบัน ณ วันออกใบ
  buyerNotVatRegistered Boolean   @default(false) // ผู้ซื้อไม่ได้จด VAT - ไม่มีเลขผู้เสียภาษีก็ออกได้
  vatRate               Decimal   @db.Decimal(5, 2)
  feeTotal              Decimal   @db.Decimal(12, 2) // ค่าธรรมเนียมกรมฯ ทดรองจ่าย ไม่คิด VAT
  serviceTotal          Decimal   @db.Decimal(12, 2)
  goodsTotal            Decimal   @db.Decimal(12, 2)
  vatAmount             Decimal   @db.Decimal(12, 2)
  grandTotal            Decimal   @db.Decimal(12, 2) // รวมเงินทั้งสิ้นตามใบกำกับ (ก่อนหัก ณ ที่จ่าย)
  whtAmount             Decimal   @db.Decimal(12, 2) // ยอดที่ลูกค้าหักจริง (อาจต่างจากบิล เช่น e-WHT 1%)
  receivedAmount        Decimal   @db.Decimal(12, 2) // grandTotal - whtAmount = เงินเข้าบัญชี
  whtMethod             String    @default("NONE") // NONE | PAPER (50 ทวิ กระดาษ) | EWHT
  whtCertificateId      String?
  whtRemindedAt         DateTime? // ทวง 50 ทวิ ครั้งล่าสุด
  replacesId            String?   @unique // ใบที่ยกเลิกไปแล้วซึ่งใบนี้ออกแทน
  replacementIssuedAt   DateTime?
  replacementReason     String?
  status                String    @default("ISSUED") // ISSUED | CANCELLED
  cancelledAt           DateTime?
  cancelReason          String?
  cancelledById         String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  whtCertificate WhtCertificate? @relation(fields: [whtCertificateId], references: [id], onDelete: SetNull)
  replaces       TaxInvoice?     @relation("TaxInvoiceReplaces", fields: [replacesId], references: [id])
  replacedBy     TaxInvoice?     @relation("TaxInvoiceReplaces")

  @@unique([year, number])
  @@index([invoiceId])
  @@index([customerId])
  @@index([issueDate])
  @@index([whtCertificateId])
}

// หนังสือรับรองการหักภาษี ณ ที่จ่าย (50 ทวิ) ที่ลูกค้าส่งมา (ผู้ใช้ 2026-09-28): ใบเดียวครอบคลุมใบกำกับได้หลายใบ (บางเจ้าส่งรวม)
// PAPER = กระดาษ ต้องแนบไฟล์ · EWHT = หักผ่านธนาคาร ต้องมีเลขอ้างอิง ไฟล์ไม่บังคับ · ยกเลิก = ปลดใบกำกับกลับเป็นรอ 50 ทวิ + ล้าง contentHash
model WhtCertificate {
  id              String    @id @default(cuid())
  customerId      String
  method          String // PAPER | EWHT
  certificateNo   String? // เลขที่ 50 ทวิ / เลขอ้างอิง e-WHT
  certificateDate DateTime?
  amount          Decimal   @db.Decimal(12, 2) // ยอดภาษีที่หักตามหนังสือรับรอง
  note            String?
  storageKey      String?   @unique
  mimeType        String?
  sizeBytes       Int?
  originalName    String?
  contentHash     String?   @unique
  createdById     String?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledById   String?

  customer    Customer     @relation(fields: [customerId], references: [id])
  taxInvoices TaxInvoice[]

  @@index([customerId])
}

// ใบเสนอราคา (ผู้ใช้ 2026-10-01): งานของ YM ต้องเสนอราคาและได้ PO ก่อนวางบิลทุกครั้ง และใช้กับลูกค้ารายอื่นได้
// kind JOB = ยอดงาน (อนุมัติแล้วออกใบวางบิลจากใบนี้) · RATE = ราคาต่อคัน (อนุมัติแล้วตั้งเป็นตารางราคาของลูกค้า)
// status DRAFT (ยังไม่มีเลข แก้ได้อิสระ) -> ISSUED -> APPROVED | REJECTED · CANCELLED · SUPERSEDED (มีฉบับแก้ไขออกแทนแล้ว)
// เลขที่ QT{ปี ค.ศ.}-{3 หลัก} ชุดเดียวทุกบัญชี · ฉบับแก้ไขใช้เลขเดิมต่อท้าย -R1, -R2 (baseNo + revision)
model QuotationSeries {
  year       Int      @id
  lastNumber Int
  updatedAt  DateTime @updatedAt
}

model Quotation {
  id               String    @id @default(cuid())
  quotationNo      String?   @unique // null = ร่าง
  baseNo           String?
  revision         Int       @default(0)
  replacesId       String?   @unique // ฉบับที่ใบนี้แก้ไขแทน
  kind             String // JOB | RATE
  status           String    @default("DRAFT")
  customerId       String? // null = ลูกค้าใหม่ที่ยังไม่อยู่ในระบบ (พิมพ์ชื่อ/ที่อยู่เองใน customerSnapshot)
  customerSnapshot Json // { name, branch, address, taxId }
  issueDate        DateTime
  validDays        Int       @default(30)
  validUntil       DateTime
  title            String    @default("")
  conditions       String?
  account          String    @default("COMPANY")
  vatRate          Decimal   @default(0) @db.Decimal(5, 2)
  whtRate          Decimal   @default(0) @db.Decimal(5, 2)
  feeTotal         Decimal   @default(0) @db.Decimal(12, 2)
  serviceTotal     Decimal   @default(0) @db.Decimal(12, 2)
  goodsTotal       Decimal   @default(0) @db.Decimal(12, 2)
  vatAmount        Decimal   @default(0) @db.Decimal(12, 2)
  whtAmount        Decimal   @default(0) @db.Decimal(12, 2)
  netTotal         Decimal   @default(0) @db.Decimal(12, 2)
  // ยอดงานแจ้งย้ายยามาฮ่าของเดือนนี้ (YYYY-MM) - ใบที่ออกแล้วล็อกรายการแจ้งย้ายของเดือนนั้น · yamahaCounts = { SMALL, LARGE } ตอนดึง
  yamahaMonth      String?
  yamahaCounts     Json?
  approvedDate     DateTime?
  poNumber         String?
  storageKey       String?   @unique // ไฟล์ PO / หลักฐานการอนุมัติ
  mimeType         String?
  sizeBytes        Int?
  originalName     String?
  contentHash      String?   @unique
  rejectReason     String?
  ratesAppliedAt   DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledById    String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer   Customer?       @relation(fields: [customerId], references: [id])
  items      QuotationItem[]
  invoices   Invoice[]
  replaces   Quotation?      @relation("QuotationRevision", fields: [replacesId], references: [id])
  replacedBy Quotation?      @relation("QuotationRevision")

  @@index([customerId])
  @@index([status])
  @@index([yamahaMonth])
}

// บรรทัดของใบเสนอราคา: JOB ใช้ช่องเดียวกับ InvoiceItem · RATE ใช้ description = ชื่อรายการ, unitPrice = ราคา + ช่อง rate (เหมือน ServiceFeeRate)
model QuotationItem {
  id              String   @id @default(cuid())
  quotationId     String
  kind            String
  description     String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  cost            Decimal? @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  rateKind        String?
  vehicleKind     String?
  ccMin           Decimal? @db.Decimal(10, 2)
  ccMax           Decimal? @db.Decimal(10, 2)
  chassisPrefix   String?
  vatInclusive    Boolean  @default(false)
  includesReceipt Boolean  @default(false)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// บรรทัดกำหนดเองของบิล (ผู้ใช้ 2026-09-29) ไม่ผูกกับรถ - งานเก่าที่ย้ายมาจากระบบเดิม / ขายสินค้า
// kind: FEE = ค่าธรรมเนียมราชการ (ไม่มี VAT ไม่หัก ณ ที่จ่าย) · SERVICE = ค่าบริการ (VAT + หัก ณ ที่จ่าย) · GOODS = ขายสินค้า (VAT ไม่หัก)
// quantity x unitPrice = amount (ยอดรวมก่อน VAT ของบรรทัด เช่น ต่อภาษีรถจักรยานยนต์ 100 x 12 คัน, ผู้ใช้ 2026-09-29)
// cost = ต้นทุนต่อหน่วย ใช้คิดกำไรภายใน ไม่พิมพ์บนบิล (null = ไม่ทราบ, FEE ต้นทุน = ยอดเสมอจึงไม่เก็บ)
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  kind        String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  vehicleId     String
  chassis       String
  brandName     String
  body          String?
  plateText     String // "8ขง 363" หรือ "" ถ้ายังไม่มีทะเบียน
  receiptNo     String?
  deliveredDate DateTime
  receiptAmount Decimal  @db.Decimal(12, 2) // ค่าใบเสร็จของคันนี้
  serviceFee    Decimal  @db.Decimal(12, 2) // ค่าดำเนินการก่อน VAT หลังหัก deduction แล้ว
  serviceLabel  String? // ข้อความต่อท้ายชื่อรายการ เช่น "(ขอใช้ต่างภูมิลำเนา)" - คันที่ label/ราคาเดียวกันถูกรวมเป็นบรรทัดเดียวบนหน้าบิล
  deduction     Decimal  @default(0) @db.Decimal(12, 2) // ยอดที่หักออกจากค่าดำเนินการแล้ว เช่น 500 เมื่อลูกค้าชำระค่าขอใช้เลขเอง
  deductionNote String?

  // งานสลับเลขของรถคันนี้ (ผู้ใช้ 2026-09-28): รถใหม่ที่รับเลขจากรถเก่าต้องเก็บค่าใบเสร็จกรมฯ ของรถเก่าด้วย
  // เก็บแยกจาก receiptAmount (ไม่รวมเป็นยอดเดียว - ผู้ใช้เลือก "แยกเก็บ") เพื่อให้ย้อนตรวจได้ว่ามาจากงานไหน ยอดเท่าไร
  // ยอดค่าธรรมเนียมบนบิล = receiptAmount + swapReceiptAmount (คิดใน computeInvoiceTotals)
  plateSwapId       String?
  swapReceiptAmount Decimal? @db.Decimal(12, 2)

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  plateSwap PlateSwap? @relation(fields: [plateSwapId], references: [id])

  @@index([invoiceId])
  @@index([vehicleId])
  @@index([plateSwapId])
}

// --- ต่อภาษี (annual tax renewal) ------------------------------------------------
// หนึ่งแถว = งานต่อภาษีหนึ่งคันหนึ่งรอบ ผูกกับ Vehicle ของงานจดใหม่ได้ (vehicleId) หรือกรอกเองทั้งหมด
// สำหรับรถที่ไม่ได้อยู่ในระบบ - ข้อมูลรถถูก snapshot ลงแถวนี้เสมอ เพื่อให้ยอดภาษีย้อนหลังไม่เพี้ยน
// แม้ Vehicle จะถูกแก้ภายหลัง
//
// ยอดเงินคำนวณตอนบันทึกการชำระ (paymentDate) ด้วย src/tax-renewal/vehicle-tax-calculator.ts แล้ว
// snapshot ลง billItems/noBillItems/taxBreakdown - ก่อนชำระจะยังว่างอยู่ หน้าเว็บคิดสดให้ดูได้
// Bill = ภาษีรถประจำปี + เงินเพิ่มกรณีล่าช้า / No Bill = ลงขัน (รถยนต์ 20, จักรยานยนต์ 10 - ติ๊กงดได้)
model TaxRenewal {
  id String @id @default(cuid())

  vehicleId  String? // รถในฐานข้อมูลรถจดใหม่ (ถ้ามี)
  customerId String?

  submitDate DateTime // วันที่ยื่นงาน (ผู้ใช้เพิ่ม 2026-09-23) - ฟอร์มตั้งค่าเริ่มต้นเป็นวันที่ทำรายการ

  // ข้อมูลรถ ณ ตอนบันทึก - ดึงจาก Vehicle ถ้าลิงก์ไว้ ไม่งั้นกรอกเอง
  // เลขตัวถัง/หมวด/เลขทะเบียน บังคับเสมอ (ผู้ใช้กำหนด 2026-09-23) เลขเครื่องกรอกหรือไม่ก็ได้
  // ไม่ @unique เพราะรถคันเดิมต่อภาษีได้ทุกปี
  chassis               String // เลขตัวถัง
  engine                String? // เลขเครื่อง
  plateCategory         String // หมวดทะเบียน
  plateNumber           String // เลขทะเบียน
  registrationProvince  String?
  vehicleType           String // ประเภทรถ (รย.1-.., รย.12-..)
  fuel                  String // ประเภทเชื้อเพลิง
  cc                    Decimal?  @db.Decimal(10, 2)
  weight                Decimal?  @db.Decimal(10, 2)
  firstRegistrationDate DateTime // ใช้คำนวณส่วนลดอายุรถและเงื่อนไขตรวจสภาพ
  ownerType             OwnerType
  ownerName             String?

  taxExpiryDate DateTime // วันครบกำหนดภาษีของรอบที่ต่อ

  // ตรวจความครบของเอกสาร - ร้านไม่ได้รับตรวจสภาพเอง แค่ติ๊กยืนยันว่ามีใบมาแล้ว
  inspectionRequired  Boolean @default(false) // ระบบคำนวณให้ (ครบ 7 ปี / รย.12 ครบ 5 ปี / ค้างภาษีเกิน 1 ปี)
  inspectionConfirmed Boolean @default(false) // มีใบตรวจ ตรอ. แล้ว
  insuranceConfirmed  Boolean @default(false) // มี พ.ร.บ. แล้ว

  // ยื่นชำระภาษี
  paymentDate      DateTime?
  skipContribution Boolean   @default(false) // ไม่มีค่าลงขันสำหรับงานนี้

  billItems    Json? // [{label, amount}] - ภาษี + เงินเพิ่ม
  noBillItems  Json? // [{label, amount}] - ลงขัน
  billTotal    Decimal? @db.Decimal(12, 2)
  noBillTotal  Decimal? @db.Decimal(12, 2)
  taxBreakdown Json? // ใบคำนวณเต็มจาก calculateVehicleTax (cycles + calculationDetails + warnings)

  receivedDate  DateTime? // รับป้ายภาษี/ใบเสร็จ
  deliveredDate DateTime? // คืนเอกสารให้ลูกค้า

  // ยกเลิกงาน (soft cancel - ผู้ใช้ 2026-09-27 ห้ามลบแถว): ADMIN/STAFF_CAR/STAFF_MOTO (ตามประเภทรถของตัวเอง) ต้องระบุ
  // เหตุผล บันทึกประวัติลง AuditLog - cancelledAt ไม่ว่าง = ยกเลิกแล้ว ไม่แสดงในรายการ ยอดรวม และภาพรวม
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id])
  cancelledBy User?     @relation("TaxRenewalCancels", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([customerId])
  @@index([taxExpiryDate])
  @@index([paymentDate])
}

// --- ประวัติการแก้ไข/ยกเลิกทั่วไป (ผู้ใช้ 2026-09-27) ---------------------------------------
// ใช้กับข้อมูลที่ไม่ใช่รถจดใหม่ (รถใช้ VehicleEditLog): ลูกค้า, ใบวางบิล, ต่อภาษี, แจ้งย้ายยามาฮ่า, สลับเลข, ผู้ใช้
// ทุกการแก้/ยกเลิกต้องมีเหตุผล (remark) บังคับที่ระดับ service - เขียนผ่าน writeAudit() ใน backend/src/audit/audit-log.ts
// แถวไม่ถูกแก้หรือลบ (append only) และไม่ผูก FK กับแถวต้นทาง จึงอยู่ครบแม้ต้นทางถูกลบ
model AuditLog {
  id         String   @id @default(cuid())
  entity     String // 'Customer' | 'Invoice' | 'TaxRenewal' | 'YamahaRelocation' | 'PlateSwap' | 'User' | 'CustomerPayment'
  entityId   String // id ของแถวต้นทาง
  action     String // คำกริยาสั้นภาษาอังกฤษ เช่น 'update' | 'cancel' | 'unpay' | 'set-password' | 'undo-return'
  remark     String // เหตุผลที่แก้/ยกเลิก
  changes    Json // { field: { from, to } } เฉพาะฟิลด์ที่เปลี่ยนจริง หรือ snapshot ก่อนยกเลิก - ห้ามเก็บรหัสผ่าน/hash
  editedById String? // ผู้ใช้ที่ทำ - งานที่รันนอกคำขอ HTTP (script) เป็น null
  createdAt  DateTime @default(now())

  editedBy User? @relation("AuditLogs", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// --- บัญชีรับเงินของลูกค้า (ผู้ใช้ 2026-09-26/27) -----------------------------------------------
// เงินของลูกค้าเข้าบัญชีบริษัท (มี VAT) หรือบัญชีบุคคล (เช่น SPI, YMAC) ลูกค้าหนึ่งรายใช้บัญชีเดียว แต่ย้ายบัญชีได้ในอนาคต
// (ผู้ใช้แยกบัญชีเพื่อกระจายฐานภาษี) จึงเก็บเป็นประวัติพร้อมวันเริ่มใช้: บัญชีของงานวันใด = แถวล่าสุดที่ effectiveFrom <= วันนั้น
// ไม่มีแถวเลย = บัญชีบริษัท - ดู backend/src/billing/billing-account.ts
model CustomerAccountPeriod {
  id            String   @id @default(cuid())
  customerId    String
  account       String // COMPANY | PERSONAL
  effectiveFrom DateTime // วันที่เริ่มใช้ (เที่ยงคืน UTC)
  remark        String // เหตุผลที่ตั้ง/ย้ายบัญชี (บังคับ)
  createdById   String?
  createdAt     DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation("CustomerAccountPeriods", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([customerId, effectiveFrom])
}

// --- บันทึกการจ่ายของลูกค้า (ผู้ใช้ 2026-09-27) ----------------------------------------------------
// ลูกค้าบางราย (SPI) กำหนดเองว่าจ่ายคันไหนเท่าไร และราคายังตกลงกันอยู่ - บันทึกตามที่ลูกค้าจ่ายมาจริงทีละครั้ง (ยอดโอน + รายคัน)
// แล้วทำตารางล้อกับรถที่ส่งงานแล้ว ให้เห็นว่าคันไหนได้เงินแล้ว/ยังไม่ได้ ไม่ผูกกับใบวางบิล (Invoice)
// ยกเลิกแบบ soft (cancelledAt) พร้อมเหตุผล + AuditLog - ดู backend/src/customer-payments
model CustomerPayment {
  id            String    @id @default(cuid())
  customerId    String
  account       String // COMPANY | PERSONAL - บัญชีของลูกค้า ณ วันที่รับเงิน (snapshot)
  paidDate      DateTime // วันที่เงินเข้า
  amount        Decimal   @db.Decimal(12, 2) // ยอดที่โอนเข้าจริง
  whtAmount     Decimal   @default(0) @db.Decimal(12, 2) // หัก ณ ที่จ่ายที่ลูกค้าแจ้ง (0 = ไม่หัก)
  reference     String? // เลขที่เอกสารจ่าย / เลขอ้างอิงของลูกค้า
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  customer    Customer              @relation(fields: [customerId], references: [id])
  createdBy   User?                 @relation("CustomerPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?                 @relation("CustomerPaymentsCancelled", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines       CustomerPaymentLine[]

  @@index([customerId, paidDate])
}

model CustomerPaymentLine {
  id        String  @id @default(cuid())
  paymentId String
  vehicleId String? // null = หาเลขตัวถังนี้ในรถของลูกค้าไม่เจอ (ยังเก็บไว้ตามที่ลูกค้าแจ้ง)
  chassis   String // เลขตัวถังตามที่ลูกค้าแจ้ง
  amount    Decimal @db.Decimal(12, 2)
  note      String?
  sortOrder Int     @default(0)

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  vehicle Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([paymentId])
  @@index([vehicleId])
}
