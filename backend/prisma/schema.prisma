// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum DocumentType {
  NEW_REGISTRATION // จดทะเบียนรถใหม่
  PLATE_SWAP // สลับเลขทะเบียน
  TRANSFER // โอนรถ
  ADDRESS_CHANGE // แจ้งย้าย
  OTHER // งานทะเบียนอื่นๆ
}

enum CaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases Case[] @relation("AssignedStaff")
}

model Customer {
  id        String   @id @default(cuid())
  name      String // ชื่อลูกค้า
  company   String? // บริษัท
  branch    String? // สาขา
  address   String? // ที่อยู่บริษัท
  taxId     String? // เลขประจำตัวผู้เสียภาษี (13 หลัก, เก็บเป็นข้อความเพื่อรักษาศูนย์นำหน้า)
  phone     String? // เบอร์โทรศัพท์
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles       Vehicle[]
  requestedCases Case[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(1000) // ลำดับแสดงผลที่กำหนดเอง ยี่ห้อที่เพิ่มทีหลังผ่าน "+ เพิ่มยี่ห้อ" จะได้ค่าเริ่มต้นนี้ (ไปท้ายรายการ)
  createdAt DateTime @default(now()) // ใช้ตัดสินลำดับระหว่างยี่ห้อที่ sortOrder เท่ากัน

  vehicles Vehicle[]
}

model Vehicle {
  id                   String   @id @default(cuid())
  date                 DateTime // วันที่
  customerId           String // ชื่อลูกค้า
  chassis              String   @unique // เลขตัวถัง
  engine               String? // เลขเครื่อง
  brandId              String // ยี่ห้อ
  fuel                 String? // ประเภทเชื้อเพลิง
  cc                   Decimal? @db.Decimal(10, 2) // ขนาด CC
  weight               Decimal? @db.Decimal(10, 2) // น้ำหนักรถ (กก.)
  color                String?
  body                 String? // ประเภทรถ (13 ตัวเลือกที่กำหนด ตรวจสอบระดับ application)
  registrationProvince String? // จังหวัดที่จดทะเบียน
  ownerProvince        String? // จังหวัดเจ้าของรถ

  // Step 2: แจ้งย้าย/ตัดบัญชี confirmation (สถานะคำนวณจาก registrationProvince เอง ไม่ต้องเก็บ)
  transferDone          Boolean   @default(false) // ลูกน้องติ๊กว่าดำเนินการแจ้งย้าย/ตัดบัญชีเรียบร้อยแล้ว
  transferCompletedDate DateTime? // วันที่ดำเนินการเสร็จ
  transferCost          Decimal?  @db.Decimal(10, 2) // ค่าใช้จ่ายจริง (ค่าเริ่มต้นมาจากตาราง FeeDeregistration/FeeRelocate)

  // Step 3: ตรวจรถ (เข้าคิวหลังจากทำ Step 2 เสร็จแล้วเท่านั้น - transferDone = true)
  inspectionDone          Boolean   @default(false) // ลูกน้องติ๊กว่าตรวจรถเรียบร้อยแล้ว
  inspectionCompletedDate DateTime? // วันที่ตรวจเสร็จ
  inspectionCost          Decimal?  @db.Decimal(10, 2) // ค่าใช้จ่ายจริง (ค่าเริ่มต้นมาจากตาราง FeeInspectionBangkok/FeeInspectionProvince)

  // Step 4: ยื่นเอกสารจดทะเบียน - ใช้คำนวณภาษีประจำปี (ดู GovernmentTax* ด้านล่าง)
  firstRegistrationDate DateTime? // วันจดทะเบียนครั้งแรก - ใช้คำนวณอายุรถและตรวจสอบมาตรการลดภาษี EV ตามช่วงเวลา

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  cases    Case[]

  @@index([customerId])
  @@index([brandId])
}

model Case {
  id           String       @id @default(cuid())
  caseNumber   String       @unique // เลขที่เรื่อง
  documentType DocumentType
  status       CaseStatus   @default(PENDING)
  notes        String?
  submittedAt  DateTime     @default(now())
  completedAt  DateTime?

  vehicleId       String
  requesterId     String
  assignedStaffId String?

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  requester     Customer @relation(fields: [requesterId], references: [id])
  assignedStaff User?    @relation("AssignedStaff", fields: [assignedStaffId], references: [id])

  transferDetail      TransferDetail?
  plateSwapDetail     PlateSwapDetail?
  addressChangeDetail AddressChangeDetail?
  documents           CaseDocument[]

  @@index([vehicleId])
  @@index([requesterId])
  @@index([assignedStaffId])
  @@index([status])
}

model TransferDetail {
  id           String   @id @default(cuid())
  caseId       String   @unique
  fromOwnerId  String
  toOwnerId    String
  transferDate DateTime
  price        Decimal? @db.Decimal(12, 2)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model PlateSwapDetail {
  id             String   @id @default(cuid())
  caseId         String   @unique
  oldPlateNumber String
  newPlateNumber String
  swapDate       DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AddressChangeDetail {
  id            String   @id @default(cuid())
  caseId        String   @unique
  oldAddress    String
  newAddress    String
  effectiveDate DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id         String   @id @default(cuid())
  caseId     String
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// --- Fee master/reference tables -------------------------------------------------
// Ported from the user's registration fee pricing spec (Excel workbook committed at
// prototype/sites-reference/docs/vehicle_registration_pricing_db.xlsx). vehicleType/brand/
// province are free-text keys validated at the application level against
// src/vehicles/vehicle-reference-data.ts (VEHICLE_TYPES, PROVINCES), matching how
// Vehicle.body/registrationProvince/ownerProvince already work — no new enum/FK needed.
// Amounts are the No bill / Bill totals used at each step of the registration workflow
// (ตัดบัญชี/แจ้งย้าย, ตรวจรถ, ยื่นเอกสารจดทะเบียน). Nullable amount = not yet provided by the
// user; do not guess a value, leave it for them to fill in.

model FeeDeregistration {
  id          String  @id @default(cuid())
  vehicleType String // ประเภทรถ (รวมรายการพิเศษ "นำรถมาตรวจ")
  brand       String  @default("อื่นๆ") // ยี่ห้อ (แยกเฉพาะ รย.1-เก๋ง 2 ตอน)
  amount      Decimal @db.Decimal(10, 2) // ค่าตัดบัญชี (บาท, No bill)

  @@unique([vehicleType, brand])
}

model FeeRelocate {
  id           String  @id @default(cuid())
  vehicleType  String
  brand        String  @default("อื่นๆ")
  noBillAmount Decimal @db.Decimal(10, 2) // ค่าแจ้งย้าย (No bill)
  billAmount   Decimal @default(5) @db.Decimal(10, 2) // ค่าแจ้งย้าย (Bill, คงที่ 5 บาท/คัน)

  @@unique([vehicleType, brand])
}

model FeeInspectionBangkok {
  id          String  @id @default(cuid())
  vehicleType String
  brand       String  @default("อื่นๆ")
  amount      Decimal @db.Decimal(10, 2) // ค่าตรวจรถ กทม. (เฉพาะกรณีตัดบัญชี)

  @@unique([vehicleType, brand])
}

model FeeInspectionProvince {
  id          String   @id @default(cuid())
  province    String
  vehicleType String
  amount      Decimal? @db.Decimal(10, 2) // ยังไม่มีข้อมูลครบทุกจังหวัด - null จนกว่าผู้ใช้จะให้ราคา

  @@unique([province, vehicleType])
}

model FeeCarBillParam {
  id     String   @id @default(cuid())
  key    String   @unique // รายการ เช่น "ค่าคำขอ (ปกติ)"
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeCarNoBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeMotorcycleBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

model FeeMotorcycleNoBillParam {
  id     String   @id @default(cuid())
  key    String   @unique
  amount Decimal? @db.Decimal(10, 2)
  note   String?
}

// --- Government annual vehicle tax (ภาษีรถประจำปี, กรมการขนส่งทางบก) -------------------
// Per the user's Step 4 spec: never combine these with the Fee*/company service-fee
// tables above - this is government tax only. vehicleFamily groups Vehicle.body by its
// รย. prefix (RY1/RY2/RY3/RY12), which is coarser than the vehicleType strings the Fee*
// tables use above; in particular the รย.12-<cc range> VEHICLE_TYPES entries are cc
// brackets for company service-fee pricing only and must NOT be reused to look up this
// government tax (ICE motorcycle tax is a flat rate regardless of cc). fuelGroup buckets
// Vehicle.fuel: ICE = เบนซิน/ดีเซล/LPG/NGV, HEV = ไฮบริด (HEV), PHEV = ปลั๊กอินไฮบริด (PHEV),
// BEV = ไฟฟ้า (BEV). See src/tax/government-tax-reference-data.ts for the classifier that
// derives vehicleFamily/fuelGroup from a Vehicle row.

enum GovTaxVehicleFamily {
  RY1 // รถยนต์นั่งส่วนบุคคลไม่เกิน 7 คน
  RY2 // รถยนต์นั่งส่วนบุคคลเกิน 7 คน
  RY3 // รถยนต์บรรทุกส่วนบุคคล
  RY12 // รถจักรยานยนต์
}

enum GovTaxFuelGroup {
  ICE
  HEV
  PHEV
  BEV
}

model GovernmentTaxCcBracket {
  id            String              @id @default(cuid())
  vehicleFamily GovTaxVehicleFamily // ปัจจุบันใช้กับ RY1 เท่านั้น (ICE/HEV/PHEV คำนวณแบบ progressive ตาม CC)
  fuelGroup     GovTaxFuelGroup
  ccFrom        Decimal             @db.Decimal(10, 2) // cc เริ่มต้นของขั้นนี้ (รวม)
  ccTo          Decimal?            @db.Decimal(10, 2) // cc สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด (ขั้นบนสุด)
  ratePerCc     Decimal             @db.Decimal(10, 4) // บาท/cc เฉพาะส่วนที่อยู่ในขั้นนี้ (ไม่ใช่สะสมทั้งคัน)
  sortOrder     Int                 @default(0)

  @@unique([vehicleFamily, fuelGroup, ccFrom])
}

model GovernmentTaxWeightBracket {
  id            String              @id @default(cuid())
  vehicleFamily GovTaxVehicleFamily // RY1 (เฉพาะ fuelGroup = BEV), RY2, RY3
  fuelGroup     GovTaxFuelGroup? // null = ใช้ได้ทุกเชื้อเพลิงในกลุ่มนี้ (RY2/RY3 ไม่แยกตามเชื้อเพลิง); RY1 ต้องระบุ BEV
  weightFrom    Decimal             @db.Decimal(10, 2) // น้ำหนัก (กก.) เริ่มต้นของขั้นนี้ (รวม)
  weightTo      Decimal?            @db.Decimal(10, 2) // น้ำหนัก (กก.) สิ้นสุดของขั้นนี้ (รวม), null = ไม่จำกัด
  amount        Decimal?            @db.Decimal(10, 2) // ภาษี/ปี (บาท) - ยังไม่มีข้อมูล รอผู้ใช้ให้ตาราง EV_WEIGHT_TAX_TABLE / RY2_WEIGHT_TAX_TABLE / RY3_WEIGHT_TAX_TABLE
  sortOrder     Int                 @default(0)

  @@unique([vehicleFamily, fuelGroup, weightFrom])
}

model GovernmentTaxEvIncentive {
  id              String              @id @default(cuid())
  vehicleFamily   GovTaxVehicleFamily // เช่น RY1 (รถยนต์ไฟฟ้า)
  label           String // ชื่อมาตรการ เช่น "มาตรการลดภาษีรถ EV ปีงบประมาณ 2569"
  effectiveFrom   DateTime // เทียบกับ Vehicle.firstRegistrationDate
  effectiveTo     DateTime?
  discountPercent Decimal?            @db.Decimal(5, 2) // % ที่ลดจากภาษีที่คำนวณได้จาก GovernmentTaxWeightBracket - ยังไม่มีข้อมูล ห้าม hard-code
  note            String?
}

model GovernmentTaxMotorcycleFlat {
  id        String          @id @default(cuid())
  fuelGroup GovTaxFuelGroup @unique // ICE = 100 บาท/ปีทุก cc (ตามกฎ); BEV = กฎรถจักรยานยนต์ไฟฟ้าแยกต่างหาก ยังไม่มีข้อมูล
  amount    Decimal?        @db.Decimal(10, 2)
  note      String?
}

// --- งานแจ้งย้ายยามาฮ่า (Yamaha relocation notice) --------------------------------
// Standalone log - not linked to Customer/Vehicle. One row = one day's notice batch for
// one size (size splits the two UI pages รถเล็ก/รถใหญ่). count is the number of vehicles
// that day; every vehicle carries both a Bill portion and a No bill portion of the fee
// (not an either/or choice per vehicle), so billFee/noBillFee are both derived from the
// same count. Fees are snapshotted at creation time from the fixed rates in
// src/yamaha-relocation/yamaha-relocation-fee.ts, so a future rate change never rewrites
// history: รถเล็ก Bill 5 บาท/คัน, No bill 10 บาท/คัน — รถใหญ่ Bill 5 บาท/คัน, No bill 20 บาท/คัน.
// The fee split is bookkeeping only - not shown in the UI, per the user's instruction.

enum YamahaRelocationSize {
  SMALL // รถเล็ก
  LARGE // รถใหญ่
}

model YamahaRelocationEntry {
  id        String               @id @default(cuid())
  date      DateTime // วันที่แจ้งย้าย
  size      YamahaRelocationSize
  count     Int // จำนวนคันในวันนั้น
  billFee   Decimal              @db.Decimal(10, 2) // count x อัตรา Bill ณ ตอนบันทึก
  noBillFee Decimal              @db.Decimal(10, 2) // count x อัตรา No bill ณ ตอนบันทึก
  createdAt DateTime             @default(now())

  @@index([size, date])
}
