# Neon pooled connection string (host ends in `-pooler`) — used by the running app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct connection string (no `-pooler`) — used only by Prisma CLI commands
# (migrate deploy, etc.), since Neon's pooler doesn't support what migrations need.
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Allowed CORS origin for the frontend. Defaults to allow-all if unset — set this to the
# deployed frontend URL in production. Not needed for local dev.
# FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Port the server listens on. Defaults to 3000 if unset.
# PORT=3000

# Anthropic API key for reading receipt photos. Leave empty to store photos without AI
# reading (staff types the amounts in). Restart the backend after changing it.
ANTHROPIC_API_KEY=

# Cloudflare R2 for photo storage (receipts, plates, registration books). Leave all four
# empty to store files on local disk under backend/uploads/receipts (dev only — Render wipes
# its disk on every deploy). Set all four to use R2. Check with: node scripts/check-r2.mjs
# Account ID: Cloudflare dashboard → R2 → right sidebar. Keys: R2 → Manage R2 API Tokens →
# Create API Token → permission "Object Read & Write", scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# โฟลเดอร์ของ environment ใน bucket (ไม่บังคับ): production = production, dev = DEV
R2_PREFIX=

# ระบบล็อกอิน: กุญแจเซ็น JWT (อย่างน้อย 16 ตัวอักษร สุ่มได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# เปลี่ยนค่า = ทุกคนต้องล็อกอินใหม่ ต้องตั้งบน Render ด้วย
AUTH_SECRET=

# บัญชี Admin คนแรก - ใช้กับ npm run seed:admin เท่านั้น (ไม่เปิดให้สมัครเป็น Admin ผ่านหน้าเว็บ)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
